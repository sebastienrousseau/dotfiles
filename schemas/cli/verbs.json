{
  "schema": "cli/verbs.v1",
  "verbs": [
    { "name": "list", "effect": "read", "powershell": "Get", "meaning": "Show many items, one per line", "replaces": ["ls", "tools", "registry"] },
    { "name": "show", "effect": "read", "powershell": "Get", "meaning": "Show one item in detail; the default for objects", "replaces": ["info", "card", "current", "display"] },
    { "name": "status", "effect": "read", "powershell": "Get", "ps_suffix": "Status", "meaning": "Short state summary", "replaces": ["state", "health-check"] },
    { "name": "diff", "effect": "read", "powershell": "Compare", "meaning": "What would change", "replaces": ["preview", "compare"] },
    { "name": "check", "effect": "read", "powershell": "Test", "meaning": "Read-only test that exits 0/1/2", "replaces": ["doctor", "lint", "audit", "validate"] },
    { "name": "verify", "effect": "read", "powershell": "Confirm", "meaning": "Cryptographic or provenance verification", "replaces": ["attest-verify"] },
    { "name": "measure", "effect": "read", "powershell": "Measure", "meaning": "Benchmark with stated conditions", "replaces": ["bench", "benchmark", "load-bench"] },
    { "name": "new", "effect": "change", "powershell": "New", "meaning": "Create something that did not exist", "replaces": ["create"] },
    { "name": "add", "effect": "change", "powershell": "Add", "meaning": "Add an existing thing to a managed set", "replaces": ["track"] },
    { "name": "set", "effect": "change", "powershell": "Set", "meaning": "Change one setting", "replaces": ["use", "switch", "enforce"] },
    { "name": "edit", "effect": "change", "powershell": "Edit", "meaning": "Open in $EDITOR", "replaces": [] },
    { "name": "remove", "effect": "change", "powershell": "Remove", "meaning": "Remove from a managed set", "replaces": ["rm", "delete", "prune"] },
    { "name": "init", "effect": "change", "powershell": "Initialize", "meaning": "First-time setup of a domain", "replaces": ["setup", "bootstrap"] },
    { "name": "install", "effect": "change", "powershell": "Install", "meaning": "Install software", "replaces": [] },
    { "name": "uninstall", "effect": "change", "powershell": "Uninstall", "confirms": true, "meaning": "Remove software or a whole setup (always confirms)", "replaces": ["purge"] },
    { "name": "update", "effect": "change", "powershell": "Update", "meaning": "Fetch and apply newer versions", "replaces": ["upgrade"] },
    { "name": "apply", "effect": "change", "powershell": "Set", "meaning": "Make the system match the declared state", "replaces": ["harden", "tune", "enable"] },
    { "name": "sync", "effect": "change", "powershell": "Sync", "meaning": "Two-way or pull-then-apply", "replaces": [] },
    { "name": "save", "effect": "change", "powershell": "Save", "meaning": "Record current changes (commit)", "replaces": ["commit"] },
    { "name": "export", "effect": "read", "powershell": "Export", "meaning": "Write data out in a portable format", "replaces": ["emit", "load", "bundle"] },
    { "name": "import", "effect": "change", "powershell": "Import", "meaning": "Read data in from a portable format", "replaces": [] },
    { "name": "backup", "effect": "change", "powershell": "Backup", "meaning": "Create a restorable archive", "replaces": [] },
    { "name": "restore", "effect": "change", "powershell": "Restore", "meaning": "Restore from a backup or snapshot", "replaces": [] },
    { "name": "rollback", "effect": "change", "powershell": "Undo", "meaning": "Return to a previous generation", "replaces": ["undo"] },
    { "name": "fix", "effect": "change", "powershell": "Repair", "meaning": "Repair what check found", "replaces": ["heal", "repair"] },
    { "name": "clean", "effect": "change", "powershell": "Clear", "meaning": "Remove caches, logs and leftovers", "replaces": ["log-rotate"] },
    { "name": "run", "effect": "any", "powershell": "Invoke", "meaning": "Run a one-shot job", "replaces": ["exec"] },
    { "name": "start", "effect": "any", "powershell": "Start", "meaning": "Start an interactive or background process", "replaces": ["chat", "launch"] },
    { "name": "stop", "effect": "change", "powershell": "Stop", "meaning": "Stop a process", "replaces": ["kill"] },
    { "name": "serve", "effect": "any", "powershell": "Start", "meaning": "Run a server in the foreground", "replaces": ["proxy"] },
    { "name": "open", "effect": "any", "powershell": "Open", "meaning": "Attach to or open an existing thing", "replaces": ["attach", "cd"] },
    { "name": "select", "effect": "read", "powershell": "Select", "meaning": "Interactive picker", "replaces": ["pick"] },
    { "name": "push", "effect": "change", "powershell": "Push", "meaning": "Send configuration to another host", "replaces": ["teleport", "deploy"] },
    { "name": "suspend", "effect": "change", "powershell": "Suspend", "meaning": "Pause processes or sessions", "replaces": ["freeze", "pause"] },
    { "name": "resume", "effect": "change", "powershell": "Resume", "meaning": "Resume what was suspended", "replaces": [] },
    { "name": "ask", "effect": "read", "powershell": "Request", "meaning": "Ask an AI a question about local context", "replaces": ["query"] },
    { "name": "login", "effect": "change", "powershell": "Connect", "meaning": "Authenticate a tool", "replaces": ["auth"] }
  ],
  "ps_shared": [
    { "powershell": "Get", "verbs": ["list", "show"], "rule": "one cmdlet; show takes -Name" },
    { "powershell": "Set", "verbs": ["set", "apply"], "rule": "never on the same object" },
    { "powershell": "Start", "verbs": ["start", "serve"], "rule": "never on the same object" }
  ]
}
