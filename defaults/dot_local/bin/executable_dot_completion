#!/usr/bin/env zsh
# shellcheck shell=bash
#compdef dot

# Zsh completion for the dot CLI, generated from the plugin manifests
# (tools/docs/gen_completions.py). Sourced into zsh it loads the script that
# `dot cli completion show zsh` prints; run from another shell it prints it.

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  printf '%s\n' "Usage: dot_completion"
  printf '%s\n' "Load (in zsh) or print the zsh completion for the dot CLI."
  exit 0
fi

if [[ -n "${ZSH_VERSION:-}" ]]; then
  # shellcheck disable=SC1090 # generated at build time
  source <(dot cli completion show zsh)
else
  dot cli completion show zsh
fi
