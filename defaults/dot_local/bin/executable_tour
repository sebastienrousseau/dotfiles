#!/bin/sh
# Interactive Tour using Gum
# Part of Dotfiles

set -eu

if ! command -v gum >/dev/null; then
  echo "Error: 'gum' is not installed."
  case "$(uname -s)" in
    Darwin)
      echo "Install: brew install gum"
      ;;
    Linux)
      if command -v snap >/dev/null; then
        echo "Install: sudo snap install gum --classic"
      else
        echo "Install: go install github.com/charmbracelet/gum@latest"
      fi
      ;;
    *)
      echo "Install gum from: https://github.com/charmbracelet/gum"
      ;;
  esac
  exit 1
fi

if [ ! -t 1 ]; then
  echo "Error: This interactive tour requires a TTY."
  exit 1
fi

clear

# Intro (match UI header style)
# The installed version, read at run time so the banner never goes stale.
tour_version="$(dot version 2>/dev/null | sed -n 's/.*\.dotfiles \([0-9][0-9.]*\).*/\1/p' | head -n 1)"
banner='██████╗  ██████╗ ████████╗███████╗██╗██╗     ███████╗███████╗
██╔══██╗██╔═══██╗╚══██╔══╝██╔════╝██║██║     ██╔════╝██╔════╝
██║  ██║██║   ██║   ██║   █████╗  ██║██║     █████╗  ███████╗
██║  ██║██║   ██║   ██║   ██╔══╝  ██║██║     ██╔══╝  ╚════██║
██████╔╝╚██████╔╝   ██║   ██║     ██║███████╗███████╗███████║
╚═════╝  ╚═════╝    ╚═╝   ╚═╝     ╚═╝╚══════╝╚══════╝╚══════╝

'"${tour_version:+v$tour_version · }"'Infrastructure‑grade shell environment'

gum style \
  --foreground 212 --border-foreground 212 --border double \
  --align center --margin "1 2" --padding "1 2" \
  "$banner"

echo ""
gum confirm "Start a quick tour?" || exit 0
clear

# Slide 1: Shell & configuration
gum style \
  --foreground 99 --border rounded --padding "1 2" --margin "1 2" \
  "Shell & configuration" \
  "Default shell: Fish. Change it in .chezmoidata.toml." \
  " " \
  "dot apply   # Apply dotfiles" \
  "dot update  # Pull and apply updates" \
  "dot diff    # Review local changes" \
  "dot doctor drift show   # Snapshot config drift" \
  "dot help    # Browse all commands"

echo ""
gum confirm "Next: Check health" || exit 0
clear

# Slide 2: Diagnostics
gum style \
  --foreground 75 --border rounded --padding "1 2" --margin "1 2" \
  "Check health" \
  "Know what’s working. See what needs attention." \
  " " \
  "dot doctor    # Health checks" \
  "dot shell history list   # History analysis" \
  "dot doctor perf measure # Startup timing"

echo ""
gum confirm "Next: Secrets" || exit 0
clear

# Slide 3: Secrets
gum style \
  --foreground 214 --border rounded --padding "1 2" --margin "1 2" \
  "Secrets (age)" \
  "Keep sensitive data local and encrypted." \
  " " \
  "dot secret init   # Create a key" \
  "dot secret edit        # Edit secrets" \
  "dot secret new # New encrypted file" \
  "dot secret key new        # Encrypt an SSH key"

echo ""
gum confirm "Next: Security (opt‑in)" || exit 0
clear

# Slide 4: Security (opt-in)
gum style \
  --foreground 150 --border double --padding "1 2" --margin "1 2" \
  "Security (opt‑in)" \
  "Explicit by design. Nothing changes without your choice." \
  " " \
  "dot security firewall apply      # Firewall hardening" \
  "dot security telemetry apply     # Disable OS telemetry" \
  "dot security dns apply       # DNS‑over‑HTTPS (Linux)" \
  "dot security lock apply   # Idle lock settings" \
  "dot security usb apply    # Disable automount" \
  "dot security disk show # Disk encryption status"

echo ""
gum confirm "Next: Themes & UX" || exit 0
clear

# Slide 5: Themes & UX
gum style \
  --foreground 212 --border rounded --padding "1 2" --margin "1 2" \
  "Themes & UX" \
  "Make it yours without changing how it works." \
  " " \
  "dot theme      # Switch theme" \
  "dot theme wallpaper set  # Apply wallpaper" \
  "dot theme font install      # Install Nerd Fonts" \
  "dot keys       # Keybindings" \
  "dot tool list --nix      # Curated utilities" \
  " " \
  "Edit ~/.dotfiles/.chezmoidata.toml for shell, features, and profiles."

echo ""
gum confirm "Next: Projects & Sandbox" || exit 0
clear

# Slide 6: Projects & Sandbox
gum style \
  --foreground 111 --border rounded --padding "1 2" --margin "1 2" \
  "Projects & sandbox" \
  "Start quickly. Experiment safely." \
  " " \
  "dot tool new <lang> <name>  # Templates: python, go, node" \
  "dot config apply --sandbox            # Safe preview (Docker/Podman)" \
  "dot edit               # Open source in editor"

echo ""
gum confirm "Next: Linting & Performance" || exit 0
clear

# Slide 7: Linting & Performance
gum style \
  --foreground 214 --border rounded --padding "1 2" --margin "1 2" \
  "Linting & Performance" \
  "Keep your scripts clean and your shell fast." \
  " " \
  "dot config check              # ShellCheck + shfmt" \
  "dot config check --fix        # Auto-format scripts" \
  "dot config check --check      # CI mode (exit 1 on failure)" \
  "dot doctor perf measure --waterfall  # Startup waterfall chart" \
  "dot doctor perf show              # Quick performance timing"

echo ""
gum confirm "Next: Finish" || exit 0
clear

# Final summary
gum style \
  --foreground 212 --border double --padding "1 2" --margin "1 2" \
  "You’re all set!" \
  " " \
  "Tip: run ‘dot update’ weekly to stay current."

echo ""
choice=$(gum choose "Run dot doctor" "Run dot doctor perf measure" "Open docs" "Exit")
case "$choice" in
  "Run dot doctor") exec dot doctor ;;
  "Run dot doctor perf measure") exec dot doctor perf measure ;;
  "Open docs") exec dot help --readme ;;
  "Exit") exit 0 ;;
esac
