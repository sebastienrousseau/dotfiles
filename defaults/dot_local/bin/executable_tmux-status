#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0 OR MIT
# Copyright (c) 2015-2026 Sebastien Rousseau
# Small, cache-free helpers for the wallpaper-aware tmux status bar.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: tmux-status apply-colours <block/label>...
       tmux-status other-sessions <current-session>
       tmux-status short-path <path>
       tmux-status system
EOF
}

# apply_colours <block/label>...: give every session its own pair of colours.
# Each argument is a pair from .chezmoidata/apple.toml: an Apple system colour
# and the black or white label that reads on it, in Apple's order. A session's
# bottom bar takes one colour and its top bar the one half the list further on
# (the opposite hue), so the two bars never match. Linear probing keeps bottom
# colours unique across the active sessions while the checksum keeps the
# assignment deterministic for a given set of session names.
apply_colours() {
  local session_id session_name index used="|"
  local -a pairs=("$@")

  ((${#pairs[@]} > 0)) || return 2
  for index in "${pairs[@]}"; do
    [[ "$index" =~ ^#[0-9A-Fa-f]{6}/#[0-9A-Fa-f]{6}$ ]] || return 2
  done

  while IFS='|' read -r session_id session_name; do
    [[ -n "$session_id" ]] || continue
    index="$(free_slot "$session_name" "$used" "${pairs[@]}")"
    used+="${pairs[$index]}|"
    set_session_colours "$session_id" "${pairs[$index]}" \
      "${pairs[$(((index + ${#pairs[@]} / 2) % ${#pairs[@]}))]}"
  done < <(tmux list-sessions -F '#{session_id}|#{session_name}' 2>/dev/null | sort -t '|' -k2 || true)
}

# free_slot <session name> <|used|pairs|> <pair>...: the index this session's
# name hashes to, probing forward past pairs other sessions already hold.
free_slot() {
  local name="$1" used="$2" candidate offset index
  shift 2
  candidate=$(($(printf '%s' "$name" | cksum | awk '{print $1}') % $#))
  local -a pairs=("$@")
  for ((offset = 0; offset < $#; offset++)); do
    index=$(((candidate + offset) % $#))
    [[ "$used" == *"|${pairs[$index]}|"* ]] || break
  done
  printf '%s' "$index"
}

# set_session_colours <session id> <bottom block/label> <top block/label>
set_session_colours() {
  local id="$1" bottom="${2%/*}" bottom_text="${2#*/}" top="${3%/*}" top_text="${3#*/}"
  tmux set-option -q -t "$id" @dot_session_colour "$bottom" \; \
    set-option -q -t "$id" @dot_session_text "$bottom_text" \; \
    set-option -q -t "$id" @dot_session_top "$top" \; \
    set-option -q -t "$id" @dot_session_top_text "$top_text" \; \
    set-option -q -t "$id" status-style "bg=$bottom,fg=$bottom_text"
}

other_sessions() {
  local current="${1:-}"
  local session first="" count=0 remaining

  while IFS= read -r session; do
    [[ -n "$session" && "$session" != "$current" ]] || continue
    ((count += 1))
    [[ -n "$first" ]] || first="$session"
  done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null || true)

  ((count > 0)) || return 0
  if ((${#first} > 16)); then
    first="${first:0:15}…"
  fi
  remaining=$((count - 1))
  printf '↔ %s' "$first"
  ((remaining == 0)) || printf ' +%d' "$remaining"
}

short_path() {
  local path="${1:-}" parent leaf
  [[ -n "$path" ]] || return 0
  path="${path%/}"
  leaf="${path##*/}"
  parent="${path%/*}"
  parent="${parent##*/}"
  if [[ -n "$parent" && "$parent" != "$leaf" ]]; then
    printf '%s/%s' "$parent" "$leaf"
  else
    printf '%s' "$leaf"
  fi
}

format_system() {
  local cpu="${1:-}" memory="${2:-}" battery="${3:-}"
  local separator="" metric

  for metric in \
    "${cpu:+ ${cpu}%}" \
    "${memory:+ ${memory}%}" \
    "${battery:+ ${battery}%}"; do
    [[ -n "$metric" ]] || continue
    printf '%s%s' "$separator" "$metric"
    separator=' · '
  done
}

system_darwin() {
  local cores cpu memory battery

  cores="$(sysctl -n hw.logicalcpu 2>/dev/null || true)"
  [[ "$cores" =~ ^[1-9][0-9]*$ ]] || cores=1
  cpu="$(
    ps -A -o %cpu= 2>/dev/null |
      awk -v cores="$cores" '{ total += $1 } END { if (NR) { value = total / cores; if (value > 100) value = 100; printf "%.0f", value } }' ||
      true
  )"
  memory="$(
    memory_pressure -Q 2>/dev/null |
      awk -F ': ' '/System-wide memory free percentage/ { gsub(/%/, "", $2); printf "%.0f", 100 - $2; exit }' ||
      true
  )"
  battery="$(
    pmset -g batt 2>/dev/null |
      awk 'match($0, /[0-9]+%/) { print substr($0, RSTART, RLENGTH - 1); exit }' ||
      true
  )"
  format_system "$cpu" "$memory" "$battery"
}

system_linux() {
  local proc_root="${TMUX_STATUS_PROC_ROOT:-/proc}"
  local power_root="${TMUX_STATUS_SYS_ROOT:-/sys}"
  local runtime_dir state_file
  local label user nice kernel idle iowait irq softirq steal rest
  local total idle_total previous_total=0 previous_idle=0 delta_total delta_idle
  local cpu="" memory="" battery="" capacity_file

  if [[ -r "$proc_root/stat" ]]; then
    read -r label user nice kernel idle iowait irq softirq steal rest <"$proc_root/stat" || true
    total=$((user + nice + kernel + idle + iowait + irq + softirq + steal))
    idle_total=$((idle + iowait))
    runtime_dir="${XDG_RUNTIME_DIR:-${TMPDIR:-${XDG_CACHE_HOME:-$HOME/.cache}}}"
    state_file="$runtime_dir/dotfiles-tmux-cpu-${UID:-0}.state"
    mkdir -p "$runtime_dir" 2>/dev/null || true
    if [[ -r "$state_file" ]] && read -r previous_total previous_idle <"$state_file"; then
      delta_total=$((total - previous_total))
      delta_idle=$((idle_total - previous_idle))
      if ((delta_total > 0)); then
        cpu=$(((100 * (delta_total - delta_idle) + delta_total / 2) / delta_total))
      fi
    else
      cpu=$(((100 * (total - idle_total) + total / 2) / total))
    fi
    printf '%s %s\n' "$total" "$idle_total" >"$state_file" 2>/dev/null || true
  fi

  if [[ -r "$proc_root/meminfo" ]]; then
    memory="$(
      awk '
        /^MemTotal:/ { total = $2 }
        /^MemAvailable:/ { available = $2 }
        END { if (total > 0) printf "%.0f", 100 * (total - available) / total }
      ' "$proc_root/meminfo" 2>/dev/null || true
    )"
  fi

  for capacity_file in "$power_root"/class/power_supply/BAT*/capacity; do
    [[ -r "$capacity_file" ]] || continue
    read -r battery <"$capacity_file" || true
    break
  done
  format_system "$cpu" "$memory" "$battery"
}

system_windows() {
  local payload cpu memory battery

  command -v powershell.exe &>/dev/null || return 0
  payload="$(
    powershell.exe -NoLogo -NoProfile -NonInteractive -Command \
      '$cpu = (Get-CimInstance Win32_Processor | Measure-Object LoadPercentage -Average).Average; $os = Get-CimInstance Win32_OperatingSystem; $mem = [math]::Round(100 * (1 - $os.FreePhysicalMemory / $os.TotalVisibleMemorySize)); $bat = (Get-CimInstance Win32_Battery | Select-Object -First 1 -ExpandProperty EstimatedChargeRemaining); Write-Output ("{0}|{1}|{2}" -f $cpu, $mem, $bat)' \
      2>/dev/null |
      tr -d '\r' |
      tail -1 ||
      true
  )"
  IFS='|' read -r cpu memory battery <<<"$payload"
  format_system "$cpu" "$memory" "$battery"
}

system_status() {
  local platform="${TMUX_STATUS_PLATFORM:-}"
  [[ -n "$platform" ]] || platform="$(uname -s 2>/dev/null || true)"
  case "$platform" in
    Darwin) system_darwin ;;
    Linux) system_linux ;;
    CYGWIN* | MINGW* | MSYS*) system_windows ;;
  esac
}

case "${1:-}" in
  apply-colours)
    shift
    apply_colours "$@"
    ;;
  other-sessions)
    shift
    other_sessions "$@"
    ;;
  short-path)
    shift
    short_path "$@"
    ;;
  system)
    shift
    system_status "$@"
    ;;
  -h | --help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
