#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0 OR MIT
# Copyright (c) 2015-2026 Sebastien Rousseau
"""dot-ai-serve — a native, dependency-free local Claude proxy.

A Meridian-style bridge with no third-party packages: it wraps the
already-installed `claude` CLI in headless stream-json mode and exposes the
standard Anthropic (`/v1/messages`) and OpenAI (`/v1/chat/completions`)
endpoints. Any tool that speaks either protocol points at
http://127.0.0.1:3456 and gets Claude on your existing subscription.

Auth, prompt caching, and rate limits are owned by the `claude` CLI — this
server only translates wire formats. Managed via `dot ai serve`.

Features: real token-by-token streaming (SSE), model routing/aliases, cost
metering (/metrics, /v1/usage), an optional daily budget cap, and a
mandatory API-key gate: DOT_AI_API_KEY, or a random token generated on first
start (0600; `dot-ai-serve --token-path` prints where it is stored). Requests whose Host
header is not this server's loopback address are refused, which blocks DNS
rebinding from browsers. Images (base64, or a URL the API fetches) reach the
model. The client's tools are shown to the model, and its tool calls come
back in each protocol's own form for the client to run (gateway_events.py).
Stdlib only — runs on any python3.
"""

import hmac
import json
import os
import secrets
import shutil
import subprocess
import sys
import tempfile
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

# The gateway's modules live in ~/.local/share/dot-ai-serve, which is
# ../share/dot-ai-serve from this script both deployed and in the repo.
# They are imported without writing bytecode beside them.
sys.dont_write_bytecode = True
sys.path.insert(
    0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "share", "dot-ai-serve")
)
from gateway_events import EventReader  # noqa: E402
from gateway_shape import Shaped, engine_message, estimate_tokens, shape_request  # noqa: E402
from gateway_wire import (  # noqa: E402
    _usage_pair,
    anthropic_response,
    anthropic_sse,
    openai_response,
    openai_sse,
)

HOST = os.environ.get("DOT_AI_HOST", "127.0.0.1")
PORT = int(os.environ.get("DOT_AI_PORT", "3456"))
CLAUDE_BIN = os.environ.get("DOT_AI_CLAUDE_BIN", "claude")
DEFAULT_MODEL = os.environ.get("DOT_AI_DEFAULT_MODEL", "sonnet")
STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
    "dot",
    "ai",
    "serve",
)
TOKEN_FILE = os.path.join(STATE_DIR, "gateway.token")
# Extra Host header values to accept (comma-separated host[:port]).
EXTRA_HOSTS = [h.strip() for h in os.environ.get("DOT_AI_ALLOWED_HOSTS", "").split(",") if h.strip()]


def _private_token(path):
    """The token in `path`, or None when the file is missing, empty, not
    owned by us, or readable by group/other (its token may have leaked)."""
    try:
        with open(path, encoding="utf-8") as fh:
            st = os.fstat(fh.fileno())
            if st.st_uid != os.getuid() or st.st_mode & 0o077:
                return None
            return fh.read().strip() or None
    except FileNotFoundError:
        return None


def load_or_create_token(path=TOKEN_FILE):
    """Return the gateway token, creating a random 0600 token file once. A
    token file that is not private to us is replaced with a fresh token."""
    directory = os.path.dirname(path)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    os.chmod(directory, 0o700)  # makedirs leaves an existing directory's mode alone
    token = _private_token(path)
    if token:
        return token
    token = secrets.token_urlsafe(32)
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        # Either another starter won the race (use its token) or the file
        # exists but is empty or not private (replace it atomically).
        # Re-reading once is enough: such a file would otherwise loop here.
        existing = _private_token(path)
        if existing:
            return existing
        tmp = f"{path}.{os.getpid()}.tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(token + "\n")
        os.replace(tmp, path)
        return token
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(token + "\n")
    return token


API_KEY = os.environ.get("DOT_AI_API_KEY", "")  # resolved in main(); never empty while serving

# Request bounds: the largest body read, how long a socket may sit idle
# (slow headers or body), and how many claude processes run at once.
MAX_BODY = 10 * 1024 * 1024
try:
    REQUEST_TIMEOUT = float(os.environ.get("DOT_AI_REQUEST_TIMEOUT", "30"))
except ValueError:
    REQUEST_TIMEOUT = 30.0
SPAWN = threading.BoundedSemaphore(4)
# The headless engine runs with no MCP servers at all, whatever the user's
# or project's config declares.
EMPTY_MCP_CONFIG = '{"mcpServers":{}}'
# The MCP server that shows a request's tools to the engine (and runs none).
TOOL_STUB = os.path.join(os.path.dirname(os.path.abspath(sys.modules["gateway_shape"].__file__)), "gateway_stub.py")

# Advertised models (also accepts any id/alias the claude CLI understands).
MODELS = [
    "claude-opus-4-8",
    "claude-opus-4-7",
    "claude-sonnet-4-6",
    "claude-opus-4-6",
    "claude-haiku-4-5-20251001",
]

# Per-million-token prices (USD) for rough cost metering, keyed by the family
# substring of the resolved model. Override with DOT_AI_PRICING (JSON).
PRICING = {"opus": (15.0, 75.0), "sonnet": (3.0, 15.0), "haiku": (0.80, 4.0)}
try:
    PRICING.update(
        {k: tuple(v) for k, v in json.loads(os.environ.get("DOT_AI_PRICING", "") or "{}").items()}
    )
except (json.JSONDecodeError, TypeError, ValueError):
    pass

# Friendly aliases → an alias the claude CLI accepts. "cheap"/"fast" route to
# haiku, "smart" to opus; common OpenAI ids map to a sensible Claude tier.
# Extend/override with DOT_AI_MODEL_MAP (JSON).
MODEL_ALIASES = {
    "cheap": "haiku",
    "fast": "haiku",
    "smart": "opus",
    "default": DEFAULT_MODEL,
    "gpt-4": "sonnet",
    "gpt-4o": "sonnet",
    "gpt-4-turbo": "sonnet",
    "gpt-3.5-turbo": "haiku",
}
try:
    MODEL_ALIASES.update(json.loads(os.environ.get("DOT_AI_MODEL_MAP", "") or "{}"))
except json.JSONDecodeError:
    pass

# Optional daily spend cap (USD). 0 disables it.
DAILY_BUDGET = float(os.environ.get("DOT_AI_DAILY_BUDGET", "0") or "0")

METRICS = {
    "started": time.time(),
    "requests": 0,
    "errors": 0,
    "streamed": 0,
    "images": 0,
    "tool_calls": 0,
    "input_tokens": 0,
    "output_tokens": 0,
    "cost_usd": 0.0,
    "by_model": {},
}
_BUDGET = {"day": time.strftime("%Y-%m-%d"), "spent": 0.0}
_LOCK = threading.Lock()


def log(msg):
    print(f"[dot-ai-serve] {msg}", file=sys.stderr, flush=True)


# ---------------------------------------------------------------------------
# Model routing + cost metering.
# ---------------------------------------------------------------------------
# A resolved model flows into the `claude` CLI argv. Map the request's value
# through a constant lookup table so the string reaching argv is ALWAYS one of
# our own literals (the untrusted value is only ever a dict key, never the
# result) — a request can't inject a flag or arbitrary value. Extend coverage
# via MODELS, or map an alias to a known tier in DOT_AI_MODEL_MAP.
_MODEL_LUT = {m: m for m in (set(MODELS) | {"opus", "sonnet", "haiku"})}


def resolve_model(model):
    """Follow the alias chain, then map the result to a known model id via a
    constant lookup table; unknown models fall back to a safe constant."""
    seen = set()
    while model in MODEL_ALIASES and model not in seen:
        seen.add(model)
        model = MODEL_ALIASES[model]
    return _MODEL_LUT.get(model or DEFAULT_MODEL, "sonnet")


def _price_for(model):
    m = resolve_model(model).lower()
    for fam, price in PRICING.items():
        if fam in m:
            return price
    return PRICING.get("sonnet", (3.0, 15.0))


def estimate_cost(model, inp, out):
    pin, pout = _price_for(model)
    return (inp * pin + out * pout) / 1_000_000.0


def _roll_day():
    today = time.strftime("%Y-%m-%d")
    if _BUDGET["day"] != today:
        _BUDGET["day"], _BUDGET["spent"] = today, 0.0


def budget_exceeded():
    if DAILY_BUDGET <= 0:
        return False
    with _LOCK:
        _roll_day()
        return _BUDGET["spent"] >= DAILY_BUDGET


def record(model, inp, out, streamed, error):
    """Fold one request into the metrics + daily-budget counters."""
    cost = estimate_cost(model, inp, out)
    with _LOCK:
        METRICS["requests"] += 1
        if error:
            METRICS["errors"] += 1
        if streamed:
            METRICS["streamed"] += 1
        METRICS["input_tokens"] += inp
        METRICS["output_tokens"] += out
        METRICS["cost_usd"] += cost
        bm = METRICS["by_model"].setdefault(
            model, {"requests": 0, "input": 0, "output": 0, "cost": 0.0}
        )
        bm["requests"] += 1
        bm["input"] += inp
        bm["output"] += out
        bm["cost"] += cost
        _roll_day()
        _BUDGET["spent"] += cost
    return cost


# ---------------------------------------------------------------------------
# Engine: run the headless `claude` CLI and stream its output token-by-token.
# ---------------------------------------------------------------------------
def stream_claude(run_model, system_prompt, prompt, images=(), tools=()):
    """Generator: yields ("delta", text) as Claude produces output and
    ("tool", call) for each client tool it calls, then a final ("done",
    usage_dict, error_or_None). Reads the CLI's stream-json NDJSON
    incrementally so callers get live tokens."""
    shaped = Shaped(run_model, system_prompt, prompt, list(images), list(tools))
    # At most SPAWN engines at once; the slot is released when the
    # generator finishes or is closed (a client that disconnects).
    with SPAWN:
        yield from _engine_events(shaped)


def _engine_cmd(run_model, workdir, tools):
    """The engine's argv. It carries NO request-derived content: the model
    is validated to a plain token (resolve_model), the prompt and images go
    via stdin, and the tools via a file in the engine's private workdir."""
    mcp, extra = EMPTY_MCP_CONFIG, []
    if tools:
        path = os.path.join(workdir, "tools.json")
        with open(path, "w", encoding="utf-8") as fh:
            json.dump(tools, fh)
        server = {"command": sys.executable, "args": [TOOL_STUB, path]}
        mcp = json.dumps({"mcpServers": {"client": server}})
        # The API's message_delta marks the end of a turn of tool calls.
        extra = ["--include-partial-messages"]
    return [
        CLAUDE_BIN,
        "-p",
        "--input-format",
        "stream-json",
        "--output-format",
        "stream-json",
        "--verbose",
        "--model",
        run_model,
        # Hermetic: ignore user/project/local settings and CLAUDE.md.
        "--setting-sources",
        "",
        # A text bridge: no Read/Bash/etc., so a request cannot reach files.
        "--tools",
        "",
        # Only the client's tools, if any: user, project and plugin MCP
        # configs are ignored. They are never allowed (no --allowedTools),
        # so the CLI refuses to run them; the client runs them.
        "--strict-mcp-config",
        "--mcp-config",
        mcp,
        *extra,
    ]


def _stderr_tail(fh, limit=4096):
    """The last line of what the engine wrote to stderr (a temp file)."""
    fh.seek(0, os.SEEK_END)
    fh.seek(max(0, fh.tell() - limit))
    lines = fh.read().decode("utf-8", "replace").strip().splitlines()
    return lines[-1] if lines else ""


def _engine_events(shaped):
    """Run one headless claude and yield its events (see stream_claude).
    It runs in an empty private directory, never the server's cwd, and
    stderr goes to a temp file: an undrained pipe fills at 64 KiB and
    stalls the engine."""
    workdir = tempfile.mkdtemp(prefix="dot-ai-serve-")
    try:
        with tempfile.TemporaryFile() as errfile:
            cmd = _engine_cmd(shaped.model, workdir, shaped.tools)
            yield from _run_engine(cmd, engine_message(shaped) + "\n", errfile, workdir)
    finally:
        shutil.rmtree(workdir, ignore_errors=True)


def _read_events(proc, reader):
    """Feed the engine's NDJSON to `reader`, yielding its events, until the
    engine ends or the reader says the turn is over."""
    for line in proc.stdout:
        try:
            evt = json.loads(line)
        except json.JSONDecodeError:
            continue
        out, stop = reader.feed(evt) if isinstance(evt, dict) else ([], False)
        yield from out
        if stop:
            return


def _run_engine(cmd, stdin_text, errfile, workdir):
    # The engine never sees the gateway's own key.
    env = {k: v for k, v in os.environ.items() if k != "DOT_AI_API_KEY"}
    try:
        proc = subprocess.Popen(
            cmd,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=errfile,
            text=True,
            bufsize=1,
            cwd=workdir,
            env=env,
        )
    except FileNotFoundError:
        yield ("done", {}, f"claude CLI not found ({cmd[0]})")
        return

    expired = threading.Event()

    def _expire():
        # Record the timeout before killing: checking timer.is_alive()
        # afterwards races with the timer thread finishing, which reported
        # a timed-out engine as "no output from claude".
        expired.set()
        proc.kill()

    timer = threading.Timer(int(os.environ.get("DOT_AI_TIMEOUT", "600")), _expire)
    timer.start()
    reader = EventReader()
    try:
        proc.stdin.write(stdin_text)
        proc.stdin.close()
        yield from _read_events(proc, reader)
    finally:
        timer.cancel()
        if proc.poll() is None:  # the turn ended, or the consumer went away
            proc.kill()
        proc.wait()
        proc.stdout.close()
    yield ("done", reader.usage, _engine_error(reader, expired.is_set(), errfile))


def _engine_error(reader, timed_out, errfile):
    """The run's error: the engine's own, or why it gave nothing."""
    if reader.error is not None or reader.text or reader.calls:
        return reader.error
    if timed_out:
        return "claude CLI timed out"
    return _stderr_tail(errfile) or "no output from claude"


def run_claude(run_model, system_prompt, prompt, images=(), tools=()):
    """Collect the full stream into (text, usage, error, calls) — the
    non-streaming path."""
    text, usage, err, calls = "", {}, None, []
    for item in stream_claude(run_model, system_prompt, prompt, images, tools):
        if item[0] == "delta":
            text += item[1]
        elif item[0] == "tool":
            calls.append(item[1])
        else:
            _, usage, err = item
    return text, usage, err, calls


# ---------------------------------------------------------------------------
# Observability.
# ---------------------------------------------------------------------------
def usage_report():
    with _LOCK:
        _roll_day()
        return {
            "object": "usage",
            "uptime_seconds": int(time.time() - METRICS["started"]),
            "requests": METRICS["requests"],
            "errors": METRICS["errors"],
            "streamed": METRICS["streamed"],
            "images": METRICS["images"],
            "tool_calls": METRICS["tool_calls"],
            "input_tokens": METRICS["input_tokens"],
            "output_tokens": METRICS["output_tokens"],
            "cost_usd": round(METRICS["cost_usd"], 6),
            "budget": {
                "daily_usd": DAILY_BUDGET,
                "spent_today_usd": round(_BUDGET["spent"], 6),
            },
            "by_model": {
                k: {**v, "cost": round(v["cost"], 6)} for k, v in METRICS["by_model"].items()
            },
        }


def metrics_text():
    with _LOCK:
        _roll_day()
        out = [
            f"dot_ai_uptime_seconds {int(time.time() - METRICS['started'])}",
            f"dot_ai_requests_total {METRICS['requests']}",
            f"dot_ai_errors_total {METRICS['errors']}",
            f"dot_ai_streamed_total {METRICS['streamed']}",
            f"dot_ai_images_total {METRICS['images']}",
            f"dot_ai_tool_calls_total {METRICS['tool_calls']}",
            f"dot_ai_input_tokens_total {METRICS['input_tokens']}",
            f"dot_ai_output_tokens_total {METRICS['output_tokens']}",
            f"dot_ai_cost_usd_total {METRICS['cost_usd']:.6f}",
            f"dot_ai_budget_today_usd {_BUDGET['spent']:.6f}",
            f"dot_ai_budget_limit_usd {DAILY_BUDGET:.6f}",
        ]
        for model, bm in METRICS["by_model"].items():
            safe = model.replace('"', "").replace("\\", "")
            out.append(f'dot_ai_model_requests_total{{model="{safe}"}} {bm["requests"]}')
            out.append(f'dot_ai_model_cost_usd_total{{model="{safe}"}} {bm["cost"]:.6f}')
    return "\n".join(out) + "\n"


# ---------------------------------------------------------------------------
# HTTP layer.
# ---------------------------------------------------------------------------
class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    # Socket timeout per read/write: a client that trickles its headers or
    # body (or never sends them) is dropped instead of holding a thread.
    timeout = REQUEST_TIMEOUT

    def log_message(self, fmt, *args):  # quieter default logging
        log(fmt % args)

    def _authed(self):
        if not API_KEY:  # main() always sets one; fail closed regardless
            return False
        expected = API_KEY.encode()
        sent = (self.headers.get("x-api-key") or "").strip().encode()
        auth = (self.headers.get("authorization") or "").strip()
        if auth[:7].lower() == "bearer ":
            auth = auth[7:].strip()
        # Evaluate both comparisons so timing does not reveal which matched.
        ok_sent = hmac.compare_digest(sent, expected)
        ok_auth = hmac.compare_digest(auth.encode(), expected)
        return ok_sent or ok_auth

    def _host_allowed(self):
        """Refuse requests whose Host header names anything but this server.
        A DNS-rebinding page reaches 127.0.0.1 under its own hostname."""
        host = (self.headers.get("host") or "").strip().lower()
        return host in allowed_hosts()

    def parse_request(self):
        if not super().parse_request():
            return False
        if not self._host_allowed():
            self._error(403, "forbidden host")
            return False
        return True

    def _send_json(self, code, obj):
        payload = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def _send_text(self, code, text, ctype="text/plain; version=0.0.4"):
        payload = text.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def _send_sse(self, generator):
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Connection", "close")
        self.end_headers()
        self.close_connection = True
        for piece in generator:
            self.wfile.write(piece)
            self.wfile.flush()

    def _error(self, code, message):
        # An error may leave a request body unread; never parse it as the
        # next request on this connection.
        self.close_connection = True
        self._send_json(code, {"type": "error", "error": {"type": "proxy_error", "message": message}})

    def do_GET(self):
        if self.path == "/health":
            ok = shutil.which(CLAUDE_BIN) is not None
            self._send_json(
                200,
                {
                    "status": "healthy" if ok else "unhealthy",
                    "engine": "claude-cli",
                    "model": DEFAULT_MODEL,
                    "claude": "found" if ok else "not-found",
                    "streaming": True,
                },
            )
        elif self.path in ("/v1/models", "/models"):
            self._send_json(
                200,
                {
                    "object": "list",
                    "data": [
                        {"id": m, "object": "model", "owned_by": "anthropic"} for m in MODELS
                    ],
                },
            )
        elif self.path in ("/v1/usage", "/usage"):
            if not self._authed():
                return self._error(401, "invalid or missing API key")
            self._send_json(200, usage_report())
        elif self.path == "/metrics":
            if not self._authed():
                return self._error(401, "invalid or missing API key")
            self._send_text(200, metrics_text())
        elif self.path == "/":
            self._send_json(
                200,
                {
                    "service": "dot-ai-serve",
                    "endpoints": [
                        "/v1/messages",
                        "/v1/chat/completions",
                        "/v1/models",
                        "/v1/usage",
                        "/metrics",
                        "/health",
                    ],
                },
            )
        else:
            self._error(404, f"unknown route {self.path}")

    def do_POST(self):
        try:
            self._admit()
            body = self._read_body()
            protocol = self._protocol()
            shaped = _shape(body)
        except Refused as exc:
            return self._error(exc.code, str(exc))
        refusal = policy_refusal(resolve_model(shaped.model), estimate_tokens(shaped))
        if refusal:
            return self._error(403, refusal)
        _count("images", len(shaped.images))
        return self._answer(protocol, shaped, bool(body.get("stream")))

    def _admit(self):
        if not self._authed():
            raise Refused(401, "invalid or missing API key")
        if budget_exceeded():
            raise Refused(429, f"daily budget of ${DAILY_BUDGET:.2f} reached — set DOT_AI_DAILY_BUDGET to adjust")

    def _read_body(self):
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            length = -1
        if length < 0:
            raise Refused(400, "invalid Content-Length")
        if length > MAX_BODY:
            raise Refused(413, "request too large")
        try:
            return json.loads(self.rfile.read(length) or b"{}")
        except json.JSONDecodeError:
            raise Refused(400, "invalid JSON body") from None

    def _protocol(self):
        route = self.path.rstrip("/")
        if route in ("/v1/messages", "/messages"):
            return "anthropic"
        if route in ("/v1/chat/completions", "/chat/completions"):
            return "openai"
        raise Refused(404, f"unknown route {self.path}")

    def _answer(self, protocol, shaped, stream):
        model, run_model = shaped.model, resolve_model(shaped.model)
        args = (run_model, shaped.system, shaped.prompt, shaped.images, shaped.tools)
        if stream:

            def on_done(inp, out, err):
                record(run_model, inp, out, True, err)

            sse = anthropic_sse if protocol == "anthropic" else openai_sse
            return self._send_sse(sse(model, _counted(stream_claude(*args)), on_done))

        text, usage, err, calls = run_claude(*args)
        _count("tool_calls", len(calls))
        inp, out = _usage_pair(usage)
        record(run_model, inp, out, False, err)
        if err:
            return self._error(502, f"claude engine: {err}")
        build = anthropic_response if protocol == "anthropic" else openai_response
        return self._send_json(200, build(model, text, usage, calls))


class Refused(Exception):
    """A request the gateway answers with an HTTP error, before any engine."""

    def __init__(self, code, message):
        super().__init__(message)
        self.code = code


def _shape(body):
    try:
        shaped = shape_request(body, DEFAULT_MODEL)
    except ValueError as exc:
        raise Refused(400, str(exc)) from None
    if not shaped.prompt and not shaped.system:
        raise Refused(400, "no message content")
    return shaped


def policy_refusal(run_model, tokens):
    """Why the AI policy refuses this request, or None (plan P1.2, ADR-025).
    With no policy file nothing is checked; with one, dot-policy decides by
    its [gateway] table, and a dot-policy that is missing or fails refuses
    every request (fail closed). Its argv carries the resolved model (one of
    our own literals), a number and a path: nothing the request wrote."""
    path = os.environ.get("DOT_AI_POLICY") or os.path.join(
        os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "dotfiles", "ai-policy.toml"
    )
    if not os.path.exists(path):
        return None
    cmd = [
        os.environ.get("DOT_POLICY_BIN") or os.path.expanduser("~/.local/bin/dot-policy"),
        "gateway", "--model", run_model, "--input-tokens", str(tokens), "--policy", path,
    ]
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=10, check=False)
    except (OSError, subprocess.TimeoutExpired):
        res = None
    if res is not None and res.returncode == 0:
        return None
    if res is not None and res.returncode == 1 and res.stdout.strip():
        return res.stdout.strip()
    return f"dot ai policy: {path} is set but dot-policy is missing or failed; every request is refused"


def _count(name, n):
    with _LOCK:
        METRICS[name] += n


def _counted(gen):
    """The engine's events, counting the tool calls among them."""
    for item in gen:
        if item[0] == "tool":
            _count("tool_calls", 1)
        yield item


def allowed_hosts():
    """Host header values accepted: loopback names on our port, the bind
    address itself, and DOT_AI_ALLOWED_HOSTS."""
    names = {"127.0.0.1", "localhost", "[::1]"}
    if HOST not in ("127.0.0.1", "localhost", "::1", "0.0.0.0", "::"):
        names.add(f"[{HOST}]" if ":" in HOST else HOST)
    hosts = {f"{n}:{PORT}" for n in names}
    hosts.update(h.lower() for h in EXTRA_HOSTS)
    return hosts


def main():
    global API_KEY
    if sys.argv[1:] == ["--token-path"]:
        # Where clients read the token from; the secret itself is never printed.
        if not API_KEY:
            load_or_create_token()
        print(TOKEN_FILE)
        return
    if sys.argv[1:]:
        log(f"unknown arguments: {' '.join(sys.argv[1:])} (supported: --token-path)")
        sys.exit(64)
    if not shutil.which(CLAUDE_BIN):
        log(f"WARNING: '{CLAUDE_BIN}' not on PATH — requests will fail until it is installed and authenticated.")
    if HOST not in ("127.0.0.1", "localhost", "::1") and not API_KEY:
        log("REFUSING to bind a non-loopback host without DOT_AI_API_KEY set.")
        sys.exit(2)
    if not API_KEY:
        API_KEY = load_or_create_token()
        log(f"auth: token from {TOKEN_FILE}")
    server = ThreadingHTTPServer((HOST, PORT), Handler)
    extra = f", budget: ${DAILY_BUDGET:.2f}/day" if DAILY_BUDGET > 0 else ""
    log(f"listening on http://{HOST}:{PORT}  (engine: {CLAUDE_BIN}, model: {DEFAULT_MODEL}{extra})")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


if __name__ == "__main__":
    main()
