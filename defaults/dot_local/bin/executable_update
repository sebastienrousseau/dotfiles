#!/usr/bin/env bash
## System Update — Update all system packages and tools.
##
## Comprehensive update utility for multiple package managers.
## Supports selective updates and combined operations.
##
## # Requirements
## - Various package managers (auto-detected)
## - sudo: For system package updates
##
## # Usage
## update                      # Update all detected managers
## update --brew               # Update Homebrew only
## update --apt                # Update APT only
## update --npm                # Update NPM globals only
## update --cargo              # Update Rust packages
## update --pip                # Update Python packages
##
## # Platform Notes
## - macOS: Updates Homebrew, npm, cargo, pip
## - Linux: Updates apt/dnf, npm, cargo, pip
## - Also checks chezmoi dotfiles status

set -euo pipefail

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_section() { printf '%b\n' "\n${CYAN}--- $1 ---${NC}"; }
log_success() { printf '%b\n' "${GREEN}Done:${NC} $1"; }
log_skip() { printf '%b\n' "${YELLOW}Skipped:${NC} $1"; }

usage() {
  printf '%s\n' \
    'Usage: update [option...]' \
    '' \
    'Update every detected package manager, or only the ones named.' \
    '' \
    'Options:' \
    '  --all      Update everything (the default)' \
    '  --brew     Homebrew' \
    '  --apt      APT (uses sudo)' \
    '  --npm      npm global packages' \
    '  --cargo    Cargo binaries and the stable Rust toolchain' \
    '  --pip      Outdated pip3 packages' \
    '  -h, --help Show this help' \
    '' \
    'Examples:' \
    '  update --brew' \
    '  update --npm --pip'
}

_have() { command -v "$1" >/dev/null 2>&1; }

# _wanted <flag>: true when updating everything or <flag> is true.
_wanted() { $UPDATE_ALL || $1; }

parse_args() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      --all) UPDATE_ALL=true ;;
      --brew) UPDATE_BREW=true UPDATE_ALL=false ;;
      --apt) UPDATE_APT=true UPDATE_ALL=false ;;
      --npm) UPDATE_NPM=true UPDATE_ALL=false ;;
      --cargo) UPDATE_CARGO=true UPDATE_ALL=false ;;
      --pip) UPDATE_PIP=true UPDATE_ALL=false ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        printf 'update: unknown option: %s\n' "$arg" >&2
        usage >&2
        exit 2
        ;;
    esac
  done
}

# Homebrew (macOS/Linux)
update_brew() {
  if ! _have brew; then
    $UPDATE_BREW && log_skip "Homebrew not installed"
    return 0
  fi
  log_section "Homebrew"
  brew update
  brew upgrade
  brew cleanup
  log_success "Homebrew updated"
}

# APT (Debian/Ubuntu)
update_apt() {
  if ! _have apt; then
    $UPDATE_APT && log_skip "APT not available"
    return 0
  fi
  log_section "APT"
  sudo apt update
  sudo apt upgrade -y
  sudo apt autoremove -y
  log_success "APT packages updated"
}

# NPM global packages
update_npm() {
  if ! _have npm; then
    $UPDATE_NPM && log_skip "NPM not installed"
    return 0
  fi
  log_section "NPM"
  npm update -g
  log_success "NPM packages updated"
}

# Cargo (Rust)
update_cargo() {
  if ! _have cargo; then
    $UPDATE_CARGO && log_skip "Cargo not installed"
    return 0
  fi
  log_section "Cargo"
  if _have cargo-install-update; then
    cargo install-update -a
  else
    echo "  Install cargo-update for automatic updates: cargo install cargo-update"
  fi
  rustup update stable 2>/dev/null || true
  log_success "Rust toolchain updated"
}

# Pip (Python)
update_pip() {
  if ! _have pip3; then
    $UPDATE_PIP && log_skip "Pip not installed"
    return 0
  fi
  log_section "Pip"
  pip3 list --outdated --format=json | python3 -c "import json,sys; print('\n'.join([p['name'] for p in json.load(sys.stdin)]))" 2>/dev/null | xargs -n1 pip3 install -U 2>/dev/null || true
  log_success "Pip packages updated"
}

# Chezmoi (dotfiles)
update_dotfiles() {
  _have chezmoi || return 0
  log_section "Dotfiles"
  chezmoi update --apply=false 2>/dev/null || true
  log_success "Dotfiles checked"
}

main() {
  UPDATE_ALL=true
  UPDATE_BREW=false
  UPDATE_APT=false
  UPDATE_NPM=false
  UPDATE_CARGO=false
  UPDATE_PIP=false
  parse_args "$@"

  # `if`, not `&&`: a function called from an && list runs without
  # errexit, and a failing package manager must still stop the run.
  if _wanted "$UPDATE_BREW"; then update_brew; fi
  if _wanted "$UPDATE_APT"; then update_apt; fi
  if _wanted "$UPDATE_NPM"; then update_npm; fi
  if _wanted "$UPDATE_CARGO"; then update_cargo; fi
  if _wanted "$UPDATE_PIP"; then update_pip; fi
  if $UPDATE_ALL; then update_dotfiles; fi

  printf '%b\n' "\n${GREEN}Update complete!${NC}"
}

main "$@"
