#!/bin/sh
# Universal directory bookmarking with history support
# Works across Bash, Zsh, and Fish

set -eu

# Names are matched as literal strings (passed through the environment, not
# as a regex or awk -v, so '.', '/' and '\' are ordinary characters).
_bm_lookup() {
  BM_NAME="$1" awk 'index($0, ENVIRON["BM_NAME"] " ") == 1 { p = substr($0, length(ENVIRON["BM_NAME"]) + 2) } END { if (p != "") print p }' "$BOOKMARKS_FILE"
}

_bm_drop() {
  BM_NAME="$1" awk 'index($0, ENVIRON["BM_NAME"] " ") != 1' "$BOOKMARKS_FILE" >"$BOOKMARKS_FILE.tmp"
  mv "$BOOKMARKS_FILE.tmp" "$BOOKMARKS_FILE"
}

BOOKMARKS_FILE="$HOME/.config/shell/bookmarks"
mkdir -p "$(dirname "$BOOKMARKS_FILE")"
touch "$BOOKMARKS_FILE"

usage() {
  echo "Usage: bm <add|goto|list|remove|update> [name]"
}

case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
  "")
    usage
    exit 1
    ;;
esac

action=$1
name=${2:-}

case "$action" in
  add)
    if [ -z "$name" ]; then
      echo "Usage: bm add <name>"
      exit 1
    fi
    # One entry per name: re-adding repoints it instead of shadowing it.
    _bm_drop "$name"
    echo "$name $(pwd)" >>"$BOOKMARKS_FILE"
    echo "Bookmark '$name' added for $(pwd)"
    ;;
  goto)
    if [ -z "$name" ]; then
      echo "Usage: bm goto <name>"
      exit 1
    fi
    target=$(_bm_lookup "$name")
    if [ -n "$target" ] && [ -d "$target" ]; then
      # We output the target path, the shell alias/function must handle the cd
      echo "$target"
    else
      echo "Bookmark '$name' not found or invalid directory" >&2
      exit 1
    fi
    ;;
  list)
    if [ -t 1 ] && command -v gum >/dev/null 2>&1; then
      cat "$BOOKMARKS_FILE" | gum table --columns Name,Path
    else
      cat "$BOOKMARKS_FILE"
    fi
    ;;
  remove)
    if [ -z "$name" ]; then
      echo "Usage: bm remove <name>"
      exit 1
    fi
    _bm_drop "$name"
    echo "Bookmark '$name' removed"
    ;;
  update)
    if [ -z "$name" ]; then
      echo "Usage: bm update <name>"
      exit 1
    fi
    _bm_drop "$name"
    echo "$name $(pwd)" >>"$BOOKMARKS_FILE"
    echo "Bookmark '$name' updated to $(pwd)"
    ;;
  *)
    echo "Unknown action: $action"
    exit 1
    ;;
esac
