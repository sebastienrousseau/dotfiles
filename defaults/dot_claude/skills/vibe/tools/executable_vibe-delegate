#!/usr/bin/env bash
# vibe-delegate — Lance Vibe en mode programmatique et capture le résultat
# Usage: vibe-delegate <workdir> <prompt> [max-turns] [agent] [timeout-secs]
#
# ROOT CAUSE FIX (2026-05-10):
#   vibe checks for a TTY on startup. Without one (e.g. when piped directly),
#   it hangs indefinitely waiting for terminal initialisation → 0 tool calls,
#   silent timeout. Fix: run vibe in a pseudo-TTY (`vibe_delegate.py run`,
#   which also enforces the timeout). The JSON streaming output is then piped
#   cleanly to the parser.
#
# PROMPT SAFETY (2026-05-12):
#   Long prompts with Python code, dicts, colons, emojis, or accented chars are
#   passed via a temp file (read by vibe via --prompt-file if supported, else via
#   a wrapper that cats the file). This avoids shell injection / truncation bugs.
#
# RUN LOG (2026-05-12):
#   Appends one row to ~/.local/share/dotfiles-ai.db after each run.
#   Fields: ts, delegate, project, prompt_words, agent, max_turns, timeout_secs,
#           exit_code, timed_out, tool_calls, files_changed, syntax_errors,
#           duration_secs, tokens_in, tokens_out, tokens_total, cost_usd, model,
#           warn_count, search_replace_fails, cost_claude_eq, wrote_nothing.
#
# The Python steps (pseudo-TTY and timeout, stream parsing, token counts,
# syntax checks, run log) live in vibe_delegate.py beside this script.

set -euo pipefail

VD_PY="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/vibe_delegate.py"

# _vd_args ARGS...: the run's settings, or exit 1 when the workdir is missing.
_vd_args() {
  WORKDIR="${1:?Usage: vibe-delegate <workdir> <prompt> [max-turns] [agent] [timeout-secs]}"
  PROMPT="${2:?Prompt required}"
  MAX_TURNS="${3:-10}"
  AGENT="${4:-}"
  TIMEOUT_SECS="${5:-180}"
  if [ ! -d "$WORKDIR" ]; then
    echo "ERROR: workdir '$WORKDIR' does not exist" >&2
    exit 1
  fi
}

# _vd_model: the model /vibe-model-pick chose, if any. VIBE_ACTIVE_MODEL is
# inherited by vibe through the pseudo-TTY.
_vd_model() {
  local flag="$HOME/.local/share/vibe-model.flag"
  VIBE_MODEL_OVERRIDE=""
  [ -f "$flag" ] || return 0
  VIBE_MODEL_OVERRIDE=$(tr -d '[:space:]' <"$flag")
  export VIBE_ACTIVE_MODEL="$VIBE_MODEL_OVERRIDE"
}

# _vd_changed_files: modified and untracked files, for post-run syntax checks.
_vd_changed_files() {
  git diff --name-only 2>/dev/null || true
  git ls-files --others --exclude-standard 2>/dev/null || true
}

_vd_banner() {
  echo "=== VIBE START ==="
  echo "Workdir : $WORKDIR"
  echo "Agent   : ${AGENT:-default}"
  echo "Model   : ${VIBE_MODEL_OVERRIDE:-(config default)}"
  echo "Turns   : $MAX_TURNS"
  echo "Timeout : ${TIMEOUT_SECS}s"
  echo "Prompt  : ${PROMPT:0:120}..."
  echo "==================="
}

# _vd_write_cmd FILE: the vibe command as a script. The prompt is embedded
# %q-quoted, so colons, quotes, emojis or code in it are never expanded.
_vd_write_cmd() {
  local -a agent=()
  [ -z "$AGENT" ] || agent=(--agent "$AGENT")
  {
    echo '#!/usr/bin/env bash'
    printf 'exec vibe'
    printf ' %q' "${agent[@]}" -p "$PROMPT" --trust --max-turns "$MAX_TURNS" \
      --output streaming --workdir "$WORKDIR"
    printf '\n'
  } >"$1"
  chmod +x "$1"
}

# _vd_run: vibe in a pseudo-TTY, its stream parsed. Under set -e a failing
# pipeline would end the script before the timeout report and run log;
# `||` keeps its status in VIBE_EXIT instead.
_vd_run() {
  VIBE_EXIT=0
  python3 "$VD_PY" run "$TIMEOUT_SECS" "$VIBE_TMP/cmd.sh" |
    python3 "$VD_PY" stream "$DELEGATE_STATS_FILE" || VIBE_EXIT=${PIPESTATUS[0]}
}

# _vd_tokens: real token counts from the newest vibe session log, when one
# exists (none when vibe was killed or failed before writing it).
_vd_tokens() {
  local log
  # mtime ordering selects the latest session log.
  # shellcheck disable=SC2012
  log=$(ls -t "${VIBE_HOME:-$HOME/.vibe}/logs/session"/*/meta.json 2>/dev/null | head -1 || true)
  [ -z "$log" ] || python3 "$VD_PY" tokens "$log" "$DELEGATE_STATS_FILE" 2>/dev/null || true
}

_vd_status() {
  echo ""
  if [ "$VIBE_EXIT" -eq 124 ]; then
    echo "=== VIBE TIMEOUT (>${TIMEOUT_SECS}s) — killed ==="
  else
    echo "=== VIBE DONE (exit: $VIBE_EXIT) ==="
  fi
}

# _vd_syntax: syntax-check the files the run created or modified.
_vd_syntax() {
  CHANGED=$(comm -13 <(printf '%s\n' "$FILES_BEFORE" | sort) <(_vd_changed_files | sort))
  printf '%s\n' "$CHANGED" | python3 "$VD_PY" syntax "$VIBE_TMP/syntax-count.txt" || true
  TOTAL_ERRORS=$(cat "$VIBE_TMP/syntax-count.txt" 2>/dev/null || echo 0)
}

_vd_git_summary() {
  local after
  after=$(git rev-parse HEAD 2>/dev/null || echo "no-git")
  echo ""
  if [ "$GIT_BEFORE" != "$after" ]; then
    echo "=== COMMITS CREATED ==="
    git log "$GIT_BEFORE".."$after" --oneline
    echo ""
    echo "=== DIFF STAT ==="
    git diff "$GIT_BEFORE".."$after" --stat
  else
    echo "=== UNCOMMITTED CHANGES ==="
    git diff --stat 2>/dev/null || echo "(no git)"
    git status --short 2>/dev/null || true
  fi
}

# _vd_log: one row in ~/.local/share/dotfiles-ai.db for this run.
_vd_log() {
  local changed_count
  # grep -c prints 0 and exits 1 when nothing changed; that is not a failure.
  changed_count=$(printf '%s\n' "$CHANGED" | grep -c '[^[:space:]]' || true)
  DELEGATE_NAME=vibe DELEGATE_WORKDIR="$WORKDIR" DELEGATE_EXIT="$VIBE_EXIT" \
    DELEGATE_TIMEOUT="$TIMEOUT_SECS" DELEGATE_PROMPT_WORDS="$PROMPT_WORDS" \
    DELEGATE_AGENT="${AGENT:-default}" DELEGATE_MAX_TURNS="$MAX_TURNS" \
    DELEGATE_FILES_CHANGED="${changed_count:-0}" DELEGATE_SYNTAX_ERRORS="${TOTAL_ERRORS:-0}" \
    DELEGATE_START_NS="$START_NS" DELEGATE_END_NS="$(date +%s%N)" \
    python3 "$VD_PY" log "$DELEGATE_STATS_FILE"
}

main() {
  _vd_args "$@"
  _vd_model
  cd "$WORKDIR"
  START_NS=$(date +%s%N)
  PROMPT_WORDS=$(printf '%s' "$PROMPT" | wc -w | tr -d ' ')
  GIT_BEFORE=$(git rev-parse HEAD 2>/dev/null || echo "no-git")
  FILES_BEFORE=$(_vd_changed_files)
  _vd_banner

  # All scratch files live in one private directory. (BSD mktemp leaves the
  # X's literal when a suffix follows them, so `mktemp /tmp/x-XXXXXX.sh` was
  # a fixed, pre-creatable path in the shared /tmp.)
  VIBE_TMP=$(mktemp -d "${TMPDIR:-/tmp}/vibe-delegate.XXXXXX")
  trap 'rm -rf "$VIBE_TMP"' EXIT
  DELEGATE_STATS_FILE="$VIBE_TMP/stats.json"
  printf '{}' >"$DELEGATE_STATS_FILE"

  _vd_write_cmd "$VIBE_TMP/cmd.sh"
  _vd_run
  _vd_tokens
  _vd_status
  _vd_syntax
  _vd_git_summary
  _vd_log
  exit "$VIBE_EXIT"
}

# Sourced (by tests), only the functions are defined.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
