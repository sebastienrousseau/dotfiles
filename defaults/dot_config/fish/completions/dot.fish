# dot fish completion. Generated by tools/docs/gen_completions.py from lib/dot/data/commands.txt (the plugin manifests). Do not edit.

function __dot_path --description 'dot words before the cursor, flags dropped, shortcuts expanded'
    set -l words
    for t in (commandline -opc)[2..-1]
        string match -q -- '-*' $t; or set -a words $t
    end
    switch "$words[1]"
        case apply
            set words config apply $words[2..-1]
        case cd
            set words config path $words[2..-1]
        case diff
            set words config diff $words[2..-1]
        case edit
            set words config edit $words[2..-1]
        case status
            set words config status $words[2..-1]
        case sync
            set words config sync $words[2..-1]
        case update
            set words system update $words[2..-1]
    end
    string join ' ' -- $words
end

function __dot_at --description 'the words before the cursor are exactly this command'
    set -l p (__dot_path)
    test "$p" = "$argv[1]"
end

function __dot_in --description 'the words before the cursor start with this command'
    set -l p (__dot_path)
    test "$p" = "$argv[1]"; or string match -q -- "$argv[1] *" "$p"
end

function __dot_patterns --description 'AI steering patterns'
    set -l dir $HOME/.config/ai/patterns
    set -q XDG_CONFIG_HOME; and set dir $XDG_CONFIG_HOME/ai/patterns
    for f in $dir/*.md
        string replace -r '.*/(.*)\.md$' '$1' -- $f
    end
end

