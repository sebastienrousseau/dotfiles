# Completions for dot-theme-sync

# Complete with theme names from themes.toml
complete -c dot-theme-sync -f -a "{{- range $h := regexFindAll "(?m)^\\[themes\\.[^.\\]]+\\]$" (include ".theme-manifest/themes.toml") -1 | sortAlpha }}{{ trimSuffix "]" (trimPrefix "[themes." $h) }} {{ end }}"

# Complete with flags
complete -c dot-theme-sync -l help -s h -d "Show help"
complete -c dot-theme-sync -l full -d "Full chezmoi apply + reload"
