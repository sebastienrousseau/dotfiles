{{- $themeName := includeTemplate "theme-name" . -}}
{{- $t := index .themes $themeName -}}
{{- $ui := $t.ui -}}
{{- $statusText := (index $ui "status_text") | default $ui.accent_text -}}
-- Generated by chezmoi from .chezmoidata/themes.toml ({{ $themeName }}).
-- Lualine in the palette's audited block/label pairs: each mode is a solid
-- block with a 7:1 label, sections b and c are fg on panel and bg, and
-- inactive windows use muted text (7:1 on bg and panel).
return {
  normal = {
    a = { fg = "{{ $ui.accent_text }}", bg = "{{ $ui.accent }}", gui = "bold" },
    b = { fg = "{{ $t.term.fg }}", bg = "{{ $ui.panel }}" },
    c = { fg = "{{ $t.term.fg }}", bg = "{{ $t.term.bg }}" },
  },
  insert = { a = { fg = "{{ $statusText }}", bg = "{{ $ui.success }}", gui = "bold" } },
  visual = { a = { fg = "{{ $statusText }}", bg = "{{ $ui.info }}", gui = "bold" } },
  replace = { a = { fg = "{{ $statusText }}", bg = "{{ $ui.error }}", gui = "bold" } },
  command = { a = { fg = "{{ $statusText }}", bg = "{{ $ui.warning }}", gui = "bold" } },
  inactive = {
    a = { fg = "{{ $ui.text_muted }}", bg = "{{ $ui.panel }}" },
    b = { fg = "{{ $ui.text_muted }}", bg = "{{ $ui.panel }}" },
    c = { fg = "{{ $ui.text_muted }}", bg = "{{ $t.term.bg }}" },
  },
}
