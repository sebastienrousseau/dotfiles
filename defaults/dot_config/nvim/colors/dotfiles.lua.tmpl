{{- $themeName := includeTemplate "theme-name" . -}}
{{- $t := index .themes $themeName -}}
{{- $ui := $t.ui -}}
-- Generated by chezmoi from .chezmoidata/themes.toml ({{ $themeName }}).
-- The editor content uses the same Apple-derived palette as the terminal and
-- the tmux bars. Every text colour reads at 7:1 (WCAG AAA) on the surface it
-- is drawn on, which decides the layout of this file:
--   - syntax colours are resolved against Normal's background only (5.6-6.8:1
--     on the panel tint), so they never sit on a tinted background: the
--     cursor line highlights its number, not the row;
--   - a selection draws sel_fg on sel_bg; popups and floats draw fg on panel;
--   - blocks (mode, search, selected item) are audited block/label pairs.
vim.cmd("highlight clear")
if vim.fn.exists("syntax_on") == 1 then
  vim.cmd("syntax reset")
end
vim.o.background = "{{ $t.mode }}"
vim.g.colors_name = "dotfiles"

local c = {
  bg = "{{ $t.term.bg }}",
  fg = "{{ $t.term.fg }}",
  panel = "{{ $ui.panel }}",
  border = "{{ $ui.border }}",
  sel_bg = "{{ $t.term.sel_bg }}",
  sel_fg = "{{ $t.term.sel_fg }}",
  comment = "{{ $t.term.c8 }}",
  muted = "{{ $ui.text_muted }}",
  red = "{{ $t.term.c1 }}",
  green = "{{ $t.term.c2 }}",
  yellow = "{{ $t.term.c3 }}",
  blue = "{{ $t.term.c4 }}",
  purple = "{{ $t.term.c5 }}",
  cyan = "{{ $t.term.c6 }}",
  pink = "{{ $t.term.c9 }}",
  mint = "{{ $t.term.c10 }}",
  orange = "{{ $t.term.c11 }}",
  indigo = "{{ $t.term.c12 }}",
  magenta = "{{ $t.term.c13 }}",
  teal = "{{ $t.term.c14 }}",
  accent = "{{ $ui.accent }}",
  accent_text = "{{ $ui.accent_text }}",
  accent_on = "{{ $ui.accent_on_surface }}",
  warning = "{{ $ui.warning }}",
  status_text = "{{ (index $ui "status_text") | default $ui.accent_text }}",
}

local function hl(group, spec)
  vim.api.nvim_set_hl(0, group, spec)
end

-- Editor surfaces
hl("Normal", { fg = c.fg, bg = c.bg })
hl("NormalNC", { fg = c.fg, bg = c.bg })
hl("NormalFloat", { fg = c.fg, bg = c.panel })
hl("FloatBorder", { fg = c.accent_on, bg = c.panel })
hl("FloatTitle", { fg = c.accent_on, bg = c.panel, bold = true })
hl("LineNr", { fg = c.comment })
hl("CursorLineNr", { fg = c.accent_on, bold = true })
hl("CursorLine", {})
hl("CursorColumn", {})
hl("ColorColumn", { bg = c.panel })
hl("SignColumn", { bg = c.bg })
hl("FoldColumn", { fg = c.comment })
hl("Folded", { fg = c.muted, bg = c.panel })
hl("EndOfBuffer", { fg = c.bg })
hl("NonText", { fg = c.comment })
hl("Whitespace", { fg = c.comment })
hl("Conceal", { fg = c.comment })
-- Separators are UI lines, not text, but the border tint (1.2-3.5:1) sits
-- under even WCAG's 3:1 non-text floor; muted text reads at 7:1.
hl("WinSeparator", { fg = c.muted })
hl("VertSplit", { link = "WinSeparator" })
hl("Visual", { fg = c.sel_fg, bg = c.sel_bg })
hl("QuickFixLine", { link = "Visual" })
hl("Search", { fg = c.status_text, bg = c.warning })
hl("IncSearch", { fg = c.accent_text, bg = c.accent, bold = true })
hl("CurSearch", { link = "IncSearch" })
hl("MatchParen", { fg = c.orange, bold = true, underline = true })
hl("Pmenu", { fg = c.fg, bg = c.panel })
hl("PmenuSel", { fg = c.accent_text, bg = c.accent, bold = true })
hl("PmenuSbar", { bg = c.border })
hl("PmenuThumb", { bg = c.accent_on })
hl("StatusLine", { fg = c.fg, bg = c.panel })
hl("StatusLineNC", { fg = c.muted, bg = c.panel })
hl("TabLine", { fg = c.muted, bg = c.panel })
hl("TabLineSel", { fg = c.accent_text, bg = c.accent, bold = true })
hl("TabLineFill", { bg = c.panel })
hl("WinBar", { fg = c.fg, bg = c.bg, bold = true })
hl("WinBarNC", { fg = c.muted, bg = c.bg })
hl("Directory", { fg = c.blue })
hl("Title", { fg = c.accent_on, bold = true })
hl("ErrorMsg", { fg = c.pink, bold = true })
hl("WarningMsg", { fg = c.orange })
hl("MoreMsg", { fg = c.green })
hl("Question", { fg = c.green })
hl("ModeMsg", { fg = c.fg, bold = true })

-- Syntax: orange keywords, blue functions, as in the reference layout.
hl("Comment", { fg = c.comment, italic = true })
hl("Constant", { fg = c.purple })
hl("String", { fg = c.green })
hl("Character", { fg = c.green })
hl("Number", { fg = c.purple })
hl("Boolean", { fg = c.purple })
hl("Float", { fg = c.purple })
hl("Identifier", { fg = c.fg })
hl("Function", { fg = c.blue })
hl("Statement", { fg = c.orange })
hl("Keyword", { fg = c.orange })
hl("Conditional", { fg = c.orange })
hl("Repeat", { fg = c.orange })
hl("Label", { fg = c.orange })
hl("Exception", { fg = c.orange })
hl("Operator", { fg = c.teal })
hl("PreProc", { fg = c.magenta })
hl("Include", { fg = c.magenta })
hl("Define", { fg = c.magenta })
hl("Macro", { fg = c.magenta })
hl("Type", { fg = c.yellow })
hl("StorageClass", { fg = c.yellow })
hl("Structure", { fg = c.yellow })
hl("Typedef", { fg = c.yellow })
hl("Special", { fg = c.cyan })
hl("SpecialChar", { fg = c.cyan })
hl("Delimiter", { fg = c.fg })
hl("Tag", { fg = c.blue })
hl("Underlined", { fg = c.blue, underline = true })
hl("Todo", { fg = c.status_text, bg = c.warning, bold = true })
hl("Error", { fg = c.pink, bold = true })
hl("NvimInternalError", { fg = c.status_text, bg = "{{ $ui.error }}", bold = true })
-- Neovim draws help-file heading rules in the background colour; show them.
hl("@markup.heading.1.delimiter.vimdoc", { fg = c.comment })
hl("@markup.heading.2.delimiter.vimdoc", { fg = c.comment })
hl("@variable", { fg = c.fg })
hl("@property", { fg = c.indigo })
hl("@variable.member", { fg = c.indigo })

-- Diagnostics, diffs and spelling: text colours on Normal's background.
local diagnostics = { Error = c.pink, Warn = c.orange, Info = c.blue, Hint = c.cyan, Ok = c.green }
for name, colour in pairs(diagnostics) do
  hl("Diagnostic" .. name, { fg = colour })
  hl("DiagnosticVirtualText" .. name, { fg = colour, italic = true })
  hl("DiagnosticUnderline" .. name, { sp = colour, undercurl = true })
  hl("DiagnosticSign" .. name, { fg = colour })
end
hl("Added", { fg = c.green })
hl("Changed", { fg = c.yellow })
hl("Removed", { fg = c.red })
hl("DiffAdd", { fg = c.green })
hl("DiffChange", { fg = c.yellow })
hl("DiffDelete", { fg = c.red })
hl("DiffText", { fg = c.yellow, bold = true, underline = true })
hl("GitSignsAdd", { fg = c.green })
hl("GitSignsChange", { fg = c.yellow })
hl("GitSignsDelete", { fg = c.red })
hl("SpellBad", { sp = c.red, undercurl = true })
hl("SpellCap", { sp = c.yellow, undercurl = true })
hl("SpellRare", { sp = c.purple, undercurl = true })
hl("SpellLocal", { sp = c.cyan, undercurl = true })

-- A running lualine keeps the theme it was set up with; hand it the new one.
-- Only when already loaded: at startup lualine loads later and reads it then.
package.loaded["lualine.themes.dotfiles"] = nil
if package.loaded["lualine"] then
  local lualine = package.loaded["lualine"]
  pcall(lualine.setup, vim.tbl_deep_extend("force", lualine.get_config(), { options = { theme = "dotfiles" } }))
end

-- :terminal buffers use the same sixteen slots as the terminal itself.
{{- range $i := until 16 }}
vim.g.terminal_color_{{ $i }} = "{{ index $t.term (printf "c%d" $i) }}"
{{- end }}
