{{- $fontFamily := default "JetBrainsMono Nerd Font" .terminal_font_family -}}
{{- $fontSize := default 20 .terminal_font_size -}}
{{- $cellHeight := default "130%" (index . "terminal_cell_height") -}}
{{- $linuxDesktop := or .features.linux_desktop .features.niri -}}

font_family {{ $fontFamily }}
{{- if eq .chezmoi.os "darwin" }}
bold_font SF Mono Bold
italic_font SF Mono Regular Italic
bold_italic_font SF Mono Bold Italic
{{- else }}
symbol_map U+E000-U+F8FF Symbols Nerd Font
{{- end }}
font_size {{ $fontSize }}
# Taller rows, bars included, for the airier reference layout. Override with
# terminal_cell_height in chezmoi data (e.g. "100%" to restore the default).
modify_font cell_height {{ $cellHeight }}

window_padding_width 16
# A terminal is a large reading surface: keep it opaque so generated sRGB
# colours retain their tested contrast instead of blending with the wallpaper.
background_opacity 1.0
# Faint (SGR 2) text is still text: kitty draws it at dim_opacity, and 0.75
# turned a 7:1 colour into roughly 4.5:1. 1.0 keeps faint text at AAA.
dim_opacity 1.0
confirm_os_window_close 0
enable_audio_bell no
cursor_trail 0
{{- if $linuxDesktop }}
linux_display_server wayland
{{- end }}

{{ $themeName := includeTemplate "theme-name" . -}}
{{- $t := index .themes $themeName -}}
background {{ $t.term.bg }}
foreground {{ $t.term.fg }}
selection_background {{ $t.term.sel_bg }}
selection_foreground {{ $t.term.sel_fg }}
cursor {{ $t.term.cursor }}

color0  {{ $t.term.c0 }}
color1  {{ $t.term.c1 }}
color2  {{ $t.term.c2 }}
color3  {{ $t.term.c3 }}
color4  {{ $t.term.c4 }}
color5  {{ $t.term.c5 }}
color6  {{ $t.term.c6 }}
color7  {{ $t.term.c7 }}
color8  {{ $t.term.c8 }}
color9  {{ $t.term.c9 }}
color10 {{ $t.term.c10 }}
color11 {{ $t.term.c11 }}
color12 {{ $t.term.c12 }}
color13 {{ $t.term.c13 }}
color14 {{ $t.term.c14 }}
color15 {{ $t.term.c15 }}
{{- /* The text half of the xterm-256 grey ramp (244-255 dark, 232-243
       light), held at 7:1 on bg by scripts/theme/aaa.py. Apps choose these
       slots themselves, so the 16 themed colours alone cannot guarantee
       AAA. Skipped for a catalog generated before the keys existed. */}}
{{- $greyBase := ternary 244 232 (eq $t.mode "dark") }}
{{- range $i := until 12 }}
{{- with index $t.term (printf "grey%d" $i) }}
color{{ add $greyBase $i }} {{ . }}
{{- end }}
{{- end }}
