#!/usr/bin/env bash
set -euo pipefail

# ── Repository hook first ─────────────────────────────────────────────
# The global core.hooksPath hides the repository's own .git/hooks, so run
# its commit-msg (conventional commits, …) first. A rejection aborts the
# commit before the branding and attribution below touch the message.
chain="$(dirname "${BASH_SOURCE[0]}")/_chain"
if [[ -x "$chain" ]]; then
  "$chain" commit-msg "$@"
fi

# ── AI Attribution (Linux kernel coding-assistants standard) ──────────
# Appends "Assisted-by:" trailer to commit messages when authored during
# an AI coding assistant session. Detects the active tool automatically.
#
# Reference: https://github.com/torvalds/linux/blob/master/Documentation/process/coding-assistants.rst
# Format:    Assisted-by: AGENT_NAME:MODEL_VERSION [TOOL1] [TOOL2]

# Attribution comes only from the environment of the process running the
# commit: each agent exports a session variable to the commands it runs.
# A `claude` process elsewhere on the machine (pgrep) or an API key in the
# shell said nothing about who wrote this commit, and mislabelled
# hand-written commits, so neither counts.
#
# Claude Code exports CLAUDECODE=1, CLAUDE_CODE_ENTRYPOINT and
# CLAUDE_CODE_SESSION_ID (checked in a live session) but no variable with
# the model, so the default below is hardcoded and goes stale whenever a
# new Opus ships. Override per session without editing this hook:
#   export CLAUDE_MODEL=claude-sonnet-5
#
# One rule per line, first match wins (Codex before Claude: a Codex run can
# inherit stale Claude state):
#   session variables (any set) | name | model variable | default model
AI_AGENT_RULES=(
  "CODEX_SESSION_ID CODEX_THREAD_ID CODEX_CI|Codex|CODEX_MODEL|codex-cli"
  "CLAUDECODE CLAUDE_CODE CLAUDE_SESSION_ID CLAUDE_CODE_SESSION_ID CLAUDE_CODE_ENTRYPOINT|Claude|CLAUDE_MODEL|claude-opus-5-5"
  "GITHUB_COPILOT_CLI COPILOT_SESSION|Copilot||copilot-cli"
  "AIDER_SESSION AIDER_MODEL|Aider|AIDER_MODEL|unknown"
  "OPENCODE_SESSION|OpenCode|OPENCODE_MODEL|unknown"
  "AGY_SESSION|Antigravity||antigravity-cli"
  "GEMINI_CLI GEMINI_SESSION_ID|Gemini|GEMINI_MODEL|gemini-cli"
  "MISTRAL_SESSION|Mistral||mistral-vibe"
  "QWEN_SESSION|Qwen||qwen-code"
  "AUTOHAND_SESSION|Autohand||autohand-code"
  "ZAI_SESSION|ZAI||zai-cli"
  "SHELL_GPT_SESSION|ShellGPT||shell-gpt"
  "OLLAMA_SESSION|Ollama|OLLAMA_MODEL|local"
)

# any_set <names>: whether any of the space-separated variables is non-empty.
any_set() {
  local name
  for name in $1; do
    [[ -n "${!name:-}" ]] && return 0
  done
  return 1
}

# detect_ai_agent: "Name:model" for the agent session this commit runs in,
# or nothing.
detect_ai_agent() {
  local rule vars name model_var model
  for rule in "${AI_AGENT_RULES[@]}"; do
    IFS='|' read -r vars name model_var model <<<"$rule"
    any_set "$vars" || continue
    if [[ -n "$model_var" ]]; then
      model="${!model_var:-$model}"
    fi
    echo "${name}:${model}"
    return
  done
}

# ── Branding only in the owner's repositories ─────────────────────────
# The signature is personal branding: a commit to someone else's project
# (or a fork that has an upstream remote) must not carry it. A repository
# counts as owned when it has at least one remote and every remote's URL
# names the owner. The owner is euxis.brandingOwner in git config,
# defaulting to sebastienrousseau.
repo_is_owned() {
  local owner remote url found=0
  owner="$(git config --get euxis.brandingOwner 2>/dev/null || echo sebastienrousseau)"
  owner="$(printf '%s' "$owner" | tr '[:upper:]' '[:lower:]')"
  for remote in $(git remote 2>/dev/null); do
    url="$(git remote get-url "$remote" 2>/dev/null | tr '[:upper:]' '[:lower:]')"
    [[ "$url" =~ [:/]${owner}/[^/]+/?$ ]] || return 1
    found=1
  done
  [[ "$found" == 1 ]]
}

# ── Branding Signature ────────────────────────────────────────────────
sig_file="${HOME}/.euxis/data/config/branding/signature.txt"
msg_file="${1:-}"

[[ -n "$msg_file" && -f "$msg_file" ]] || exit 0

# Skip merge commits, fixups, and squashes
first_line="$(head -1 "$msg_file")"
if [[ "$first_line" =~ ^Merge\ |^fixup!\ |^squash!\  ]]; then
  exit 0
fi

# ── Inject AI attribution if not already present ──────────────────────
# add_attribution <msg-file>: append the Assisted-by trailer for the
# current agent session, if any. Line-anchored: a literal mention of
# `Assisted-by:` inside the commit body (e.g. when the commit message
# *describes* the trailer) must not fool the hook into skipping injection.
add_attribution() {
  local ai_agent
  grep -Eq "^Assisted-by:" "$1" && return 0
  ai_agent="$(detect_ai_agent)"
  [[ -n "$ai_agent" ]] || return 0
  # interpret-trailers joins an existing block (Signed-off-by, …) instead
  # of opening a new paragraph; git reads trailers from the last one only.
  git interpret-trailers --in-place --trailer "Assisted-by: $ai_agent" "$1" 2>/dev/null ||
    printf '\nAssisted-by: %s\n' "$ai_agent" >>"$1"
}
add_attribution "$msg_file"

# ── Inject branding signature if not already present ──────────────────
[[ -f "$sig_file" ]] || exit 0
repo_is_owned || exit 0

first_sig_line="$(sed -n '1p' "$sig_file")"
[[ -n "$first_sig_line" ]] || exit 0
grep -Fqx -- "$first_sig_line" "$msg_file" && exit 0

# Git reads trailers (Signed-off-by, Assisted-by, …) from the LAST
# paragraph only. Appending the signature after them used to push the
# trailer block into the body, so DCO checks and `%(trailers:...)` no
# longer saw the sign-off. Insert the signature BEFORE a trailing
# trailer block when there is one; otherwise append as before. Comment
# lines at the end (an editor's template) are kept, after everything.
tmp_msg="$(mktemp)"
trap 'rm -f "$tmp_msg"' EXIT
EUXIS_SIG="$(cat "$sig_file")" awk '
  { lines[NR] = $0 }
  END {
    n = NR
    while (n > 0 && (lines[n] ~ /^[[:space:]]*$/ || lines[n] ~ /^#/)) n--
    start = n
    while (start > 0 && lines[start] !~ /^[[:space:]]*$/) start--
    start++
    trailers = (n >= start)
    for (i = start; i <= n; i++) if (lines[i] !~ /^[A-Za-z][A-Za-z-]*: /) trailers = 0
    if (trailers && start > 1) {
      for (i = 1; i < start - 1; i++) print lines[i]
      print ""; print ENVIRON["EUXIS_SIG"]; print ""
      for (i = start; i <= n; i++) print lines[i]
    } else {
      for (i = 1; i <= n; i++) print lines[i]
      if (n > 0) print ""
      print ENVIRON["EUXIS_SIG"]
    }
    tail = 0
    for (i = n + 1; i <= NR; i++) if (lines[i] ~ /^#/) { if (!tail) print ""; tail = 1; print lines[i] }
  }' "$msg_file" >"$tmp_msg"
cat "$tmp_msg" >"$msg_file"
printf '\n' >>"$msg_file"
