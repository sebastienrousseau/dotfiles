{{- $fontFamily := default "JetBrainsMono Nerd Font" .terminal_font_family -}}
{{- $fontSize := default 20 .terminal_font_size -}}
{{- $themeName := includeTemplate "theme-name" . -}}
{{- $t := index .themes $themeName -}}
[window]
padding = { x = 16, y = 12 }
opacity = {{ if eq .chezmoi.os "darwin" }}0.92{{ else }}0.96{{ end }}
option_as_alt = {{ if eq .chezmoi.os "darwin" }}"Both"{{ else }}"None"{{ end }}

[font]
size = {{ $fontSize }}
normal = { family = "{{ $fontFamily }}" }
{{- if eq .chezmoi.os "darwin" }}
offset = { x = 0, y = 1 }
{{- else }}
offset = { x = 0, y = 0 }
{{- end }}

[colors.primary]
background = "{{ $t.term.bg }}"
foreground = "{{ $t.term.fg }}"

[colors.cursor]
cursor = "{{ $t.term.cursor }}"
text = "{{ $t.term.cursor_text }}"

[colors.selection]
background = "{{ $t.term.sel_bg }}"
text = "{{ $t.term.sel_fg }}"

[colors.normal]
black = "{{ $t.term.c0 }}"
red = "{{ $t.term.c1 }}"
green = "{{ $t.term.c2 }}"
yellow = "{{ $t.term.c3 }}"
blue = "{{ $t.term.c4 }}"
magenta = "{{ $t.term.c5 }}"
cyan = "{{ $t.term.c6 }}"
white = "{{ $t.term.c7 }}"

[colors.bright]
black = "{{ $t.term.c8 }}"
red = "{{ $t.term.c9 }}"
green = "{{ $t.term.c10 }}"
yellow = "{{ $t.term.c11 }}"
blue = "{{ $t.term.c12 }}"
magenta = "{{ $t.term.c13 }}"
cyan = "{{ $t.term.c14 }}"
white = "{{ $t.term.c15 }}"
