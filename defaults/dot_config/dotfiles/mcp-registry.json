{
  "registryVersion": "2026.03",
  "servers": {
    "git": {
      "transport": "stdio",
      "launcher": "${HOME}/.local/share/dot-mcp/python/git/venv/bin/mcp-server-git",
      "package": "mcp-server-git==2026.8.18",
      "auth": "env",
      "authProfile": "env-token",
      "scope": "repo-local",
      "verification": "hash-pinned-package"
    },
    "memory": {
      "transport": "stdio",
      "launcher": "${HOME}/.local/share/dot-mcp/node/node_modules/.bin/mcp-server-memory",
      "package": "@modelcontextprotocol/server-memory@2026.8.31",
      "auth": "env",
      "authProfile": "none",
      "scope": "workspace-local",
      "verification": "hash-pinned-package"
    },
    "sqlite": {
      "transport": "stdio",
      "launcher": "${HOME}/.local/share/dot-mcp/python/sqlite/venv/bin/mcp-server-sqlite",
      "package": "mcp-server-sqlite==2025.4.25",
      "auth": "env",
      "authProfile": "none",
      "scope": "workspace-local",
      "verification": "hash-pinned-package"
    },
    "example-remote": {
      "transport": "streamable-http",
      "url": "https://mcp.example.com/v1",
      "headers": { "X-Org": "dotfiles" },
      "auth": "oauth2",
      "authProfile": "oauth2",
      "authConfig": {
        "provider": "https://auth.example.com",
        "clientId": "${MCP_OAUTH_CLIENT_ID}",
        "scopes": ["mcp:read", "mcp:write"]
      },
      "scope": "enterprise",
      "verification": "registry-approved",
      "enabled": false
    }
  }
}
