# palette.v1: the active theme's palette, rendered by chezmoi from
# .theme-manifest/themes.toml for the theme `dot theme` applies. Readers take
# the colours from here instead of parsing the manifest: lib/dot/ui.sh (dot-ui)
# and scripts/theme/sync-ai-cli-themes.py. Generated; `dot theme` rewrites it.
# Lines are KEY=VALUE; colours are #rrggbb, absent when the theme has none.
{{- $themes := (include ".theme-manifest/themes.toml" | fromToml).themes }}
{{- $themeName := includeTemplate "theme-name" (dict "theme" .theme "themes" $themes) }}
{{- $t := index $themes $themeName }}
DOT_PALETTE=palette.v1
THEME={{ $themeName }}
MODE={{ $t.mode | default "dark" }}
{{- range $key := list "accent" "error" "warning" "success" "info" "panel" "border" }}
{{- with dig "ui" $key "" $t }}
{{ upper $key }}={{ . }}
{{- end }}
{{- end }}
{{- range $key := list "fg" "bg" }}
{{- with dig "term" $key "" $t }}
{{ upper $key }}={{ . }}
{{- end }}
{{- end }}
