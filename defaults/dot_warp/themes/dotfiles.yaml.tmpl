{{- /*
  Warp theme generated from the active dotfiles theme.

  Deployed to: ~/.warp/themes/dotfiles.yaml on every chezmoi apply.
  Pick "dotfiles" in Warp Settings -> Appearance -> Themes.

  Schema reference: https://docs.warp.dev/appearance/custom-themes
*/ -}}
{{- $themeName := includeTemplate "theme-name" . -}}
{{- $t := index .themes $themeName -}}
{{- $details := "darker" -}}
{{- if eq $t.mode "light" -}}{{- $details = "lighter" -}}{{- end }}
# Active dotfiles theme: {{ $themeName }}
# Regenerated by chezmoi apply.
accent: '{{ $t.ui.accent }}'
background: '{{ $t.term.bg }}'
foreground: '{{ $t.term.fg }}'
details: '{{ $details }}'
terminal_colors:
  normal:
    black:   '{{ $t.term.c0 }}'
    red:     '{{ $t.term.c1 }}'
    green:   '{{ $t.term.c2 }}'
    yellow:  '{{ $t.term.c3 }}'
    blue:    '{{ $t.term.c4 }}'
    magenta: '{{ $t.term.c5 }}'
    cyan:    '{{ $t.term.c6 }}'
    white:   '{{ $t.term.c7 }}'
  bright:
    black:   '{{ $t.term.c8 }}'
    red:     '{{ $t.term.c9 }}'
    green:   '{{ $t.term.c10 }}'
    yellow:  '{{ $t.term.c11 }}'
    blue:    '{{ $t.term.c12 }}'
    magenta: '{{ $t.term.c13 }}'
    cyan:    '{{ $t.term.c14 }}'
    white:   '{{ $t.term.c15 }}'
