encryption = "age"
# Source directory for dotfiles - uses chezmoi's built-in homeDir variable
# Template syntax: .chezmoi.homeDir accesses chezmoi's internal data
sourceDir = "{{ .chezmoi.homeDir }}/.dotfiles"

# Variable fallback - Age encryption variables with fallback chain:
# promptString function behavior:
# - If value exists in chezmoi data: use stored value
# - If value doesn't exist AND stdin is a TTY: prompt user
# - Non-interactive (CI, drift detection): silently use the default so
#   `chezmoi init --apply=false` doesn't die on "could not open a new TTY".
#   Override in CI via CHEZMOI_AGE_IDENTITY / CHEZMOI_AGE_RECIPIENT env vars.
{{- $age_identity := "" }}
{{- $age_recipient := "" }}
{{- if stdinIsATTY }}
{{-   $age_identity = promptString "age_identity" "~/.config/chezmoi/key.txt" }}
{{-   $age_recipient = promptString "age_recipient" "" }}
{{- else }}
{{-   $age_identity = env "CHEZMOI_AGE_IDENTITY" }}
{{-   if eq $age_identity "" }}{{ $age_identity = "~/.config/chezmoi/key.txt" }}{{ end }}
{{-   $age_recipient = env "CHEZMOI_AGE_RECIPIENT" }}
{{- end }}

# Conditional encryption block - only enable if age_identity is provided
# Template control flow: "if ne $age_identity" checks if variable is not empty
# This entire [age] section is only rendered if user provided an identity
{{ if ne $age_identity "" }}

[age]
    # Variable interpolation: $age_identity expands to the stored/prompted value
    identity = "{{ $age_identity }}"

    # Nested conditional with whitespace control
    # The dash suffix in template tags removes leading whitespace
    # Only adds recipient line if user provided a non-empty value
{{- if ne $age_recipient "" }}
    recipient = "{{ $age_recipient }}"
{{- end }}
{{ end }}

[merge]
    command = "vimdiff"

[data]
# User profile data with promptString fallback chains.
# Interactive path: prompt with the shown default; stored for next run.
# Non-interactive path (CI, drift detection, container builds): never
# prompt. Take CHEZMOI_<KEY> from the environment, else the value already
# stored in this config, else the default, so a re-init without a TTY no
# longer resets a configured identity to placeholders. git_name and
# git_email default to empty, not "Your Name"/"you@example.com": the
# gitconfig template then falls back to name/email (seeded by install.sh)
# or omits [user], and git refuses to commit rather than committing as a
# placeholder.
{{- $tty := stdinIsATTY }}
{{- $stored := dict }}
{{- range $k := list "profile" "theme" "git_name" "git_email" "git_signingkey" "git_signingformat" }}
{{-   $v := get $ $k | toString }}
{{-   if and (ne $v "<nil>") (ne $v "Your Name") (ne $v "you@example.com") }}{{ $_ := set $stored $k $v }}{{ end }}
{{- end }}
profile           = "{{ if $tty }}{{ promptString "profile" "laptop" }}{{ else }}{{ coalesce (env "CHEZMOI_PROFILE") (get $stored "profile") "laptop" }}{{ end }}"
theme             = "{{ if $tty }}{{ promptString "theme" "tokyonight-night" }}{{ else }}{{ coalesce (env "CHEZMOI_THEME") (get $stored "theme") "tokyonight-night" }}{{ end }}"
git_name          = "{{ if $tty }}{{ promptString "git_name" "Your Name" }}{{ else }}{{ coalesce (env "CHEZMOI_GIT_NAME") (get $stored "git_name") | default "" }}{{ end }}"
git_email         = "{{ if $tty }}{{ promptString "git_email" "you@example.com" }}{{ else }}{{ coalesce (env "CHEZMOI_GIT_EMAIL") (get $stored "git_email") | default "" }}{{ end }}"
git_signingkey    = "{{ if $tty }}{{ promptString "git_signingkey" "~/.ssh/id_ed25519" }}{{ else }}{{ coalesce (env "CHEZMOI_GIT_SIGNINGKEY") (get $stored "git_signingkey") "~/.ssh/id_ed25519" }}{{ end }}"
git_signingformat = "{{ if $tty }}{{ promptString "git_signingformat" "ssh" }}{{ else }}{{ coalesce (env "CHEZMOI_GIT_SIGNINGFORMAT") (get $stored "git_signingformat") "ssh" }}{{ end }}"

# Expose age variables in data section for use in other templates
# Variable scope: $age_identity and $age_recipient defined at file top are accessible here
# Data section variables become available as .age_identity and .age_recipient in other templates
# This creates a bridge between template variables and chezmoi data
age_identity = "{{ $age_identity }}"
age_recipient = "{{ $age_recipient }}"
