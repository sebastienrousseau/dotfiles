<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.sebastienrousseau.ollama</string>

	<key>ProgramArguments</key>
	<array>
		<string>{{ .chezmoi.homeDir }}/.local/share/mise/shims/ollama</string>
		<string>serve</string>
	</array>

	<!-- Tuned for 8 GB unified memory: one model, one request, compact KV cache. -->
	<key>EnvironmentVariables</key>
	<dict>
		<!-- mise shim resolves the version pinned in conf.d, never downloads. -->
		<key>PATH</key>
		<string>{{ .chezmoi.homeDir }}/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>MISE_OFFLINE</key>
		<string>1</string>
		<key>OLLAMA_HOST</key>
		<string>127.0.0.1:11434</string>
		<key>OLLAMA_FLASH_ATTENTION</key>
		<string>1</string>
		<key>OLLAMA_KV_CACHE_TYPE</key>
		<string>q8_0</string>
		<key>OLLAMA_CONTEXT_LENGTH</key>
		<string>16384</string>
		<key>OLLAMA_MAX_LOADED_MODELS</key>
		<string>1</string>
		<key>OLLAMA_NUM_PARALLEL</key>
		<string>1</string>
		<key>OLLAMA_KEEP_ALIVE</key>
		<string>30m</string>
	</dict>

	<key>RunAtLoad</key>
	<true/>

	<key>KeepAlive</key>
	<true/>

	<key>ProcessType</key>
	<string>Interactive</string>

	<key>StandardOutPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/ollama.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/ollama.launchd.log</string>
</dict>
</plist>
