#!/usr/bin/env bash
# run_onchange_26-build-dot-mcp.sh.tmpl
# Builds the stdio MCP server (`dot mcp serve`) to ~/.local/bin/dot-mcp when
# its Go source changes. Unlike the cockpit this is not opt-in: the published
# card at .well-known/mcp/server-card.json advertises `dot mcp serve` as a
# transport, so any workstation with a Go toolchain should have the server
# ready. Skips cleanly when no Go toolchain is available (`dot mcp serve` then
# builds it on demand into the user cache).
{{- if ne .chezmoi.os "windows" }}

set -euo pipefail

# Source hashes baked in at render time so this script's content changes when
# the server source changes, retriggering chezmoi onchange.
# main.go:      {{ include "dot_local/share/dot-mcp/main.go" | sha256sum }}
# server.go:    {{ include "dot_local/share/dot-mcp/server.go" | sha256sum }}
# jsonrpc.go:   {{ include "dot_local/share/dot-mcp/jsonrpc.go" | sha256sum }}
# tools.go:     {{ include "dot_local/share/dot-mcp/tools.go" | sha256sum }}
# resources.go: {{ include "dot_local/share/dot-mcp/resources.go" | sha256sum }}
# paths.go:     {{ include "dot_local/share/dot-mcp/paths.go" | sha256sum }}
# go.mod:       {{ include "dot_local/share/dot-mcp/go.mod" | sha256sum }}
# Third-party MCP servers run by mcp_servers.json, installed from these
# committed, hash-pinned manifests (see install-servers.sh):
# installer:    {{ include "dot_local/share/dot-mcp/executable_install-servers.sh" | sha256sum }}
# npm lock:     {{ include "dot_local/share/dot-mcp/node/package-lock.json" | sha256sum }}
# git reqs:     {{ include "dot_local/share/dot-mcp/python/git/requirements.txt" | sha256sum }}
# sqlite reqs:  {{ include "dot_local/share/dot-mcp/python/sqlite/requirements.txt" | sha256sum }}

SRC="$HOME/.local/share/dot-mcp"
OUT="$HOME/.local/bin/dot-mcp"

[[ -f "$SRC/main.go" ]] || {
  echo "dot-mcp: source not deployed yet — skipping."
  exit 0
}

# npm ci --ignore-scripts and uv pip install --require-hashes; nothing is
# fetched unverified when Claude starts a server. A failure is reported but
# does not block the dot-mcp build; re-run "$SRC/install-servers.sh".
if [[ -x "$SRC/install-servers.sh" ]]; then
  echo "Installing pinned MCP servers…"
  "$SRC/install-servers.sh" ||
    echo "dot-mcp: MCP server install incomplete; re-run $SRC/install-servers.sh" >&2
fi

# Resolve a Go toolchain (mise shims put `go` on PATH when activated).
if ! command -v go >/dev/null 2>&1; then
  echo "dot-mcp: no Go toolchain — install via mise to enable. Skipping."
  exit 0
fi

mkdir -p "$HOME/.local/bin"
{{ template "go-build-command" . }}
echo "Building dot-mcp (MCP server)…"
if dot_build_go_binary; then
  echo "dot-mcp installed: $OUT"
else
  echo "dot-mcp: build failed; existing binary preserved. See compiler diagnostics above." >&2
  exit 1
fi
{{- end }}
