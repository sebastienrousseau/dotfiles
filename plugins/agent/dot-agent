#
# dot-agent: the entry of the agent plugin (ADR-020 N2). bin/dot runs it with
# the words after `dot agent`. Its declared spellings become the subcommands
# of cmd_mode (libexec/agent.sh) or of libexec/agents.sh for context files;
# any other word, or none, goes to cmd_mode as it always has.

set -euo pipefail

_AGENT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

case "${1:-} ${2:-}" in
  "context show") exec bash "$_AGENT_DIR/libexec/agents.sh" list "${@:3}" ;;
  "context check") exec bash "$_AGENT_DIR/libexec/agents.sh" check "${@:3}" ;;
  "context apply") exec bash "$_AGENT_DIR/libexec/agents.sh" render "${@:3}" ;;
esac

# shellcheck source-path=SCRIPTDIR source=../../lib/dot/sdk.sh
source "${DOT_SDK:-$_AGENT_DIR/../../lib/dot}/sdk.sh"
# shellcheck source-path=SCRIPTDIR source=../../lib/dot/log.sh
source "${DOT_SDK:-$_AGENT_DIR/../../lib/dot}/log.sh"
# shellcheck source-path=SCRIPTDIR source=libexec/agent.sh
source "$_AGENT_DIR/libexec/agent.sh"

dot_ui_command_banner "AI and Agents" "agent" "$@"

# agent_spelling WORD... — the cmd_mode subcommand a spelling runs; other
# words run cmd_mode as they are.
agent_spelling() {
  case "${1:-} ${2:-}" in
    "mode list" | "mode show" | "mode set" | "mode run") cmd_mode "${@:2}" ;;
    "card show") cmd_mode card "${@:3}" ;;
    "card check") cmd_mode conformance "${@:3}" ;;
    "log show") cmd_mode log "${@:3}" ;;
    "status "*) cmd_mode current "${@:2}" ;;
    "check "*) cmd_mode doctor "${@:2}" ;;
    *) cmd_mode "$@" ;;
  esac
}

agent_spelling "$@"
