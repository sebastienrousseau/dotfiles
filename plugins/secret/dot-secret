#
# The entry of the secret plugin, dot-secret (ADR-020 N2). bin/dot runs it
# with the words after `dot secret`, one of the spellings its manifest
# declares as built; each becomes the subcommand of libexec/secrets.sh that
# implements it.

set -euo pipefail

_ENTRY_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# secret_module SUBCOMMAND... — run the module.
secret_module() {
  exec bash "$_ENTRY_DIR/libexec/secrets.sh" "$@"
}

case "${1:-} ${2:-}" in
  "key new") secret_module ssh-key "${@:3}" ;;
  "cert list") secret_module ssh-cert status "${@:3}" ;;
  "cert new") secret_module ssh-cert issue "${@:3}" ;;
  "cert remove") secret_module ssh-cert revoke "${@:3}" ;;
  "provider show") secret_module secrets provider "${@:3}" ;;
esac
case "${1:-}" in
  init) secret_module secrets-init "${@:2}" ;;
  new) secret_module secrets-create "${@:2}" ;;
  edit | list | set) secret_module secrets "$@" ;;
  show) secret_module secrets get "${@:2}" ;;
  export) secret_module secrets load "${@:2}" ;;
  check)
    # shellcheck source-path=SCRIPTDIR source=../../lib/dot/utils.sh
    source "$_ENTRY_DIR/../../lib/dot/utils.sh"
    run_script "scripts/diagnostics/secret-governance.sh" "Secret governance script" "${@:2}"
    ;;
esac
echo "dot: 'dot secret $*' is not a command; run 'dot help secret'" >&2
exit 127
