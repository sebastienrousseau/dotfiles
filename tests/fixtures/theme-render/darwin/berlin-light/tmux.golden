# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  TMUX CONFIGURATION (Universal)                                          ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# --- GENERAL SETTINGS ---
set -g default-terminal "xterm-256color"
if-shell 'uname | grep -q Linux' 'set -g default-terminal "tmux-256color"'
set-option -sa terminal-overrides ",*256col*:Tc"

unbind C-b
set -g prefix C-a
bind C-a send-prefix

set -g mouse on
set -g history-limit 102400
set -g set-clipboard on
set -g escape-time 10
set -g focus-events on
set -g repeat-time 600
# New panes inherit an explicit appearance signal even when OSC 11 cannot pass
# through tmux. Gemini, Qwen, Claude, OpenCode, and other adaptive TUIs use it.
set-environment -g COLORTERM "truecolor"
set-environment -g COLORFGBG "0;15"
set-environment -g AIDER_DARK_MODE "false"
set-environment -g AIDER_LIGHT_MODE "true"
set-environment -g AIDER_CODE_THEME "solarized-light"
set-environment -g AIDER_USER_INPUT_COLOR "#005f08"
set-environment -g AIDER_TOOL_ERROR_COLOR "#a80000"
set-environment -g AIDER_TOOL_WARNING_COLOR "#764600"
set-environment -g AIDER_ASSISTANT_OUTPUT_COLOR "#0046c3"
setw -g xterm-keys on
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on
set -g aggressive-resize on
set -g monitor-activity on
set -g visual-activity off
set -g visual-bell off
set -g visual-silence off
setw -g allow-rename off
setw -g automatic-rename off
setw -g mode-keys vi

# --- COPY MODE (Vim-style) ---

# Enter copy mode with prefix + [
bind [ copy-mode

# Vim-style selection and yanking
bind -T copy-mode-vi v send-keys -X begin-selection
bind -T copy-mode-vi C-v send-keys -X rectangle-toggle
bind -T copy-mode-vi y send-keys -X copy-selection-and-cancel
bind -T copy-mode-vi Escape send-keys -X cancel

# Additional copy mode bindings
bind -T copy-mode-vi H send-keys -X start-of-line
bind -T copy-mode-vi L send-keys -X end-of-line

# macOS clipboard integration
if-shell 'uname | grep -q Darwin' {
  bind -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "pbcopy"
  bind -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "pbcopy"
  bind ] run "pbpaste | tmux load-buffer - && tmux paste-buffer"
}

# --- SMART NAVIGATION (Neovim + Tmux) ---
# Seamless C-h/j/k/l navigation between Neovim splits and Tmux panes.
# When the active pane runs Neovim, keys are forwarded to it; otherwise
# Tmux handles pane selection directly.
is_vim="ps -o state= -o comm= -t '#{pane_tty}' \
  | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?g?(view|l?n?vim?x?|fzf)(diff)?$'"

bind -n C-h if-shell "$is_vim" "send-keys C-h" "select-pane -L"
bind -n C-j if-shell "$is_vim" "send-keys C-j" "select-pane -D"
bind -n C-k if-shell "$is_vim" "send-keys C-k" "select-pane -U"
bind -n C-l if-shell "$is_vim" "send-keys C-l" "select-pane -R"

# Restore C-h/j/k/l in copy-mode-vi so scrolling / cursor movement
# is not intercepted by the smart-navigation bindings above.
bind -T copy-mode-vi C-h select-pane -L
bind -T copy-mode-vi C-j select-pane -D
bind -T copy-mode-vi C-k select-pane -U
bind -T copy-mode-vi C-l select-pane -R

# --- KEY BINDINGS & NAVIGATION ---

# Reload Config
bind r source-file ~/.config/tmux/tmux.conf \; display "tmux.conf reloaded"

# Sessionizer (fuzzy session switcher)
bind f run-shell "~/.local/bin/tmux-sessionizer"

# Window Management
bind -r C-h previous-window
bind -r C-l next-window
bind a last-window
bind Tab last-window
bind c new-window -c "#{pane_current_path}"
bind N new-window -c "#{pane_current_path}"
bind n command-prompt -p "New window name:" "new-window -n '%%' -c '#{pane_current_path}'"
bind R command-prompt -p "Rename window:" "rename-window '%%'"
bind X confirm-before -p "kill-window #W? (y/n)" kill-window

# Splits (Current Path)
bind % split-window -h -c "#{pane_current_path}"
bind '"' split-window -v -c "#{pane_current_path}"
bind '\' split-window -v -c "#{pane_current_path}"
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
bind _ split-window -h -c "#{pane_current_path}"

# Pane Navigation (Vim-style)
bind -r h select-pane -L
bind -r j select-pane -D
bind -r k select-pane -U
bind -r l select-pane -R
bind -r z resize-pane -Z

# Pane Resizing
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5

# Pane Movement
bind < swap-pane -U
bind > swap-pane -D
bind q kill-pane

# Toggle synchronize-panes (type in all panes simultaneously)
bind S setw synchronize-panes \; display "Sync panes: #{?synchronize-panes,ON,OFF}"

# AI cockpit — launch a provider in a named window rooted at the active pane.
# The status bar detects these sessions and labels the active provider.
bind A display-menu -T "#[align=centre] AI CLI cockpit " -x C -y C \
  "Cockpit" a "run-shell '~/.local/bin/tmux-ai launch cockpit #{q:pane_current_path}'" \
  "" \
  "Claude Code" c "run-shell '~/.local/bin/tmux-ai launch claude #{q:pane_current_path}'" \
  "Codex" x "run-shell '~/.local/bin/tmux-ai launch codex #{q:pane_current_path}'" \
  "Copilot" p "run-shell '~/.local/bin/tmux-ai launch copilot #{q:pane_current_path}'" \
  "OpenCode" o "run-shell '~/.local/bin/tmux-ai launch opencode #{q:pane_current_path}'" \
  "Aider" i "run-shell '~/.local/bin/tmux-ai launch aider #{q:pane_current_path}'" \
  "Goose" g "run-shell '~/.local/bin/tmux-ai launch goose #{q:pane_current_path}'" \
  "Kimi" k "run-shell '~/.local/bin/tmux-ai launch kimi #{q:pane_current_path}'" \
  "Qwen" q "run-shell '~/.local/bin/tmux-ai launch qwen #{q:pane_current_path}'"

# Session Management
bind C-c new-session
bind C-f command-prompt -p find-session 'switch-client -t %%'
bind K confirm-before -p "kill all sessions? (y/n)" kill-server

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  THEME — Session Block Bars                                              ║
# ║  Colors from .chezmoidata/themes.toml (berlin-light)  ║
# ╚══════════════════════════════════════════════════════════════════════════╝
#
# A fixed frame with one per-session colour, every label white: the top bar
# (the pane border line) is black with the current window and the system
# indicators on Apple cyan; the bottom bar is the session's own Apple colour
# (unique per session) with the time on the same cyan. Bar blocks are Apple's
# Increased contrast (light) values, the deep variants Apple defines for
# white text (exact at 18pt and up). Cyan is never a session colour. Nothing
# appears in both bars, and nothing depends on the window width.
# Following the Apple HIG colour guidance:
#   - colour on large areas, white labels on every bar block (7:1, or WCAG
#     large-text 4.5:1 for Apple's exact values at 18pt and up);
#   - one meaning per colour: session colour = this session, cyan = the
#     fixed readouts (time, indicators), error = prefix armed or bell,
#     warning = activity;
#   - no state by colour alone: the terminal icon becomes a keyboard while
#     the prefix is armed, the active window is bold and flagged `*`, and
#     bell/activity keep tmux's own `!`/`#` flags;
#   - every label meets WCAG AAA in the -light and -dark theme alike.

# --- Session colours: the theme accent until tmux-status assigns each one ---
set -g @dot_session_colour "#4840d3"
set -g @dot_session_text "#ffffff"
run-shell -b "test ! -x ~/.local/bin/tmux-status || ~/.local/bin/tmux-status apply-colours '#e9152d/#ffffff' '#c55300/#ffffff' '#a16a00/#ffffff' '#008932/#ffffff' '#008575/#ffffff' '#1e6ef4/#ffffff' '#564ade/#ffffff' '#b02fc2/#ffffff' '#e7124d/#ffffff' '#956d51/#ffffff'"
set-hook -g session-created "run-shell -b \"~/.local/bin/tmux-status apply-colours '#e9152d/#ffffff' '#c55300/#ffffff' '#a16a00/#ffffff' '#008932/#ffffff' '#008575/#ffffff' '#1e6ef4/#ffffff' '#564ade/#ffffff' '#b02fc2/#ffffff' '#e7124d/#ffffff' '#956d51/#ffffff'\""
set-hook -g session-renamed "run-shell -b \"~/.local/bin/tmux-status apply-colours '#e9152d/#ffffff' '#c55300/#ffffff' '#a16a00/#ffffff' '#008932/#ffffff' '#008575/#ffffff' '#1e6ef4/#ffffff' '#564ade/#ffffff' '#b02fc2/#ffffff' '#e7124d/#ffffff' '#956d51/#ffffff'\""

# --- Bottom bar ---
set -g status on
set -g status-interval 10
set -g status-position bottom
set -g status-justify left
# Transparent between the badges, as in the reference: the terminal's own
# background with the theme's text colour (7:1 on it in light and dark).
set -g status-style "bg=default,fg=#1d1d1e"
set -g status-left-length 40
set -g status-right-length 120

# User-overridable modules. `set -o` keeps values from a local tmux.conf or
# command line, making the generated theme customizable without forking it.
set -ogq @dot_status_show_path on
set -ogq @dot_status_show_system on

# Mode badge (like Neovim's NORMAL): the session on its own colour, PREFIX
# on the alert colour while the prefix is armed, COPY in copy mode. Each
# state is named in text, not colour alone.
set -g status-left "\
#[fg=#{?client_prefix,#ffffff,#{@dot_session_text}},bg=#{?client_prefix,#e7124d,#{@dot_session_colour}},bold] #{?client_prefix, PREFIX,#{?pane_in_mode,COPY, #S}} \
#[bg=default,nobold] "

# Context on the transparent middle, then the time on its cyan badge.
# Nothing depends on the client width, so a half-screen window shows exactly
# what a full-screen one does.
set -g status-right "\
#[fg=#1d1d1e,bg=default,bold]#{?pane_synchronized,SYNC · ,}#{?#{==:#{pane_current_command},ssh},SSH · ,}\
#[nobold]#{?#{==:#{@dot_status_show_path},on},#{b:pane_current_path} ,}\
#[fg=#ffffff,bg=#007eae,bold] %H:%M "

# The other windows sit on the transparent middle; the current one is named
# in the top bar, so the bottom lists only the ones you would switch to.
set -g window-status-format "#[fg=#1d1d1e,bg=default,nobold] #I:#W#F "
set -g window-status-current-format ""

set -g window-status-separator ""
set -g window-status-bell-style "bg=#e7124d,fg=#ffffff,bold"
set -g window-status-activity-style "bg=#c55300,fg=#ffffff,bold"

# --- Top bar: the pane border line, as in the reference layout ---
# The active pane shows the window in white on black (21:1) and the system
# indicators (one `tmux-status system` sample per interval) on Apple cyan;
# other panes show a quiet label on the border surface (accent_on_surface is
# audited at 7:1 on border).
set -g pane-border-status top
set -g pane-border-lines single
set -g pane-border-format "\
#{?pane_active,\
#[fg=#ffffff#,bg=#000000#,bold] #I:#W#F#{?window_zoomed_flag, ,} #[fill=#000000]\
#{?#{==:#{@dot_status_show_system},on},#[align=right]#[fg=#ffffff#,bg=#007eae#,bold] #(~/.local/bin/tmux-status system) ,},\
#[fg=#0f25b1#,bg=#d1cfd5] #P: #{pane_current_command} #[fill=#d1cfd5]}"

# --- Pane Borders ---
# Border lines are UI, not text, but the border tint sits under WCAG's 3:1
# non-text floor on some themes; muted text reads at 7:1 on bg.
set -g pane-border-style "fg=#3d3d40"
# Black on black: the active pane's top-bar border cells blend into the black
# window block, so the top bar starts at the left edge like the reference.
set -g pane-active-border-style "fg=#000000,bg=#000000"
set -g display-panes-colour "#6a0080"
set -g display-panes-active-colour "#4840d3"

# --- Messages & Menus: the clock's tint, so text stays 7:1 ---
set -g message-style "bg=#ffe4dd,fg=#742a1e"
set -g message-command-style "bg=#ffe4dd,fg=#742a1e"
set -g mode-style "bg=#d1cfd5,fg=#0f25b1,bold"

# --- Clock ---
setw -g clock-mode-colour "#4840d3"
setw -g clock-mode-style 24

# --- Copy Mode Highlight ---
set -g copy-mode-match-style "bg=#ff8d28,fg=#000000"
set -g copy-mode-current-match-style "bg=#4840d3,fg=#ffffff,bold"

# --- LINUX SPECIFIC ---
if-shell 'uname | grep -q Linux' {
  bind -n WheelDownPane select-pane -t= \; send-keys -M
  bind -n WheelUpPane if-shell -F -t = "#{mouse_any_flag}" "send-keys -M" "if -Ft= '#{pane_in_mode}' 'send-keys -M' 'select-pane -t=; copy-mode -e; send-keys -M'"
  # Use cb utility for cross-platform clipboard (Wayland, X11, WSL)
  bind-key -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel "cb"
  bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "cb"
}

# --- PLUGINS (TPM) ---
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

set -g @continuum-restore 'on'
set -g @continuum-save-interval '15'

# Initialize TMUX plugin manager
run '~/.tmux/plugins/tpm/tpm'
