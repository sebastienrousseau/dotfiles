[window]
padding = { x = 16, y = 12 }
# Preserve the generated sRGB palette and its tested contrast ratios.
opacity = 1.0
option_as_alt = "Both"

[font]
size = 20
normal = { family = "JetBrainsMono Nerd Font" }
offset = { x = 0, y = 1 }

[colors.primary]
background = "#e9f4fa"
foreground = "#1c1d1e"

[colors.cursor]
cursor = "#005a75"
text = "#e9f4fa"

[colors.selection]
background = "#c2d3dc"
text = "#1c1d1e"

[colors.normal]
black = "#2b2c2d"
red = "#a50015"
green = "#005f19"
yellow = "#5c5000"
blue = "#005477"
magenta = "#91038b"
cyan = "#005769"
white = "#6c6d6e"

[colors.bright]
black = "#515354"
red = "#a20002"
green = "#00600e"
yellow = "#5c5000"
blue = "#005478"
magenta = "#95008f"
cyan = "#00576a"
white = "#959697"
