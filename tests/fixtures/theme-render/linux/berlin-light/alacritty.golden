[window]
padding = { x = 16, y = 12 }
# Preserve the generated sRGB palette and its tested contrast ratios.
opacity = 1.0
option_as_alt = "None"

[font]
size = 20
normal = { family = "JetBrainsMono Nerd Font" }
offset = { x = 0, y = 0 }

[colors.primary]
background = "#f3f1fa"
foreground = "#1d1d1e"

[colors.cursor]
cursor = "#4840d3"
text = "#fffdff"

[colors.selection]
background = "#d3cceb"
text = "#1d1d1e"

[colors.normal]
black = "#2c2c2d"
red = "#a80000"
green = "#005f08"
yellow = "#764600"
blue = "#0046c3"
magenta = "#8e00a1"
cyan = "#005582"
white = "#515152"

[colors.bright]
black = "#48484a"
red = "#a70022"
green = "#005d4f"
yellow = "#972c00"
blue = "#3334c3"
magenta = "#7d0091"
cyan = "#00596f"
white = "#969697"
