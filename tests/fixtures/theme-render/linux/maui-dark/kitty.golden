font_family JetBrainsMono Nerd Font
symbol_map U+E000-U+F8FF Symbols Nerd Font
font_size 20

window_padding_width 16
# A terminal is a large reading surface: keep it opaque so generated sRGB
# colours retain their tested contrast instead of blending with the wallpaper.
background_opacity 1.0
dim_opacity 0.75
confirm_os_window_close 0
enable_audio_bell no
cursor_trail 0
linux_display_server wayland

background #0f1f21
foreground #f1f6f7
selection_background #1c4248
selection_foreground #f1f6f7
cursor #60daee

color0  #314143
color1  #fa756d
color2  #61d677
color3  #e5cc4b
color4  #61b9f2
color5  #f28de7
color6  #60daee
color7  #b7b9b9
color8  #4e6163
color9  #ff9d93
color10 #7ef391
color11 #ffe866
color12 #97d3ff
color13 #ffb2f8
color14 #9df3ff
color15 #e2e3e3
