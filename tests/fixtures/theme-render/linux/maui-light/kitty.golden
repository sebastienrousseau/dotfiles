font_family JetBrainsMono Nerd Font
symbol_map U+E000-U+F8FF Symbols Nerd Font
font_size 20

window_padding_width 16
# A terminal is a large reading surface: keep it opaque so generated sRGB
# colours retain their tested contrast instead of blending with the wallpaper.
background_opacity 1.0
dim_opacity 0.75
confirm_os_window_close 0
enable_audio_bell no
cursor_trail 0
linux_display_server wayland

background #e9f4fa
foreground #1c1d1e
selection_background #c2d3dc
selection_foreground #1c1d1e
cursor #005a75

color0  #2b2c2d
color1  #a50015
color2  #005f19
color3  #5c5000
color4  #005477
color5  #91038b
color6  #005769
color7  #6c6d6e
color8  #515354
color9  #a20002
color10 #00600e
color11 #5c5000
color12 #005478
color13 #95008f
color14 #00576a
color15 #959697
