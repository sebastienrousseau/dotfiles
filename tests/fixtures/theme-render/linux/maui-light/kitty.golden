font_family JetBrainsMono Nerd Font
symbol_map U+E000-U+F8FF Symbols Nerd Font
font_size 20
# Taller rows, bars included, for the airier reference layout. Override with
# terminal_cell_height in chezmoi data (e.g. "100%" to restore the default).
modify_font cell_height 130%

window_padding_width 16
# A terminal is a large reading surface: keep it opaque so generated sRGB
# colours retain their tested contrast instead of blending with the wallpaper.
background_opacity 1.0
# Faint (SGR 2) text is still text: kitty draws it at dim_opacity, and 0.75
# turned a 7:1 colour into roughly 4.5:1. 1.0 keeps faint text at AAA.
dim_opacity 1.0
confirm_os_window_close 0
enable_audio_bell no
cursor_trail 0
linux_display_server wayland

background #e9f4fa
foreground #1c1d1e
selection_background #c2d3dc
selection_foreground #1c1d1e
cursor #005e8b

color0  #2b2c2d
color1  #a80000
color2  #005f08
color3  #764600
color4  #0046c3
color5  #8e00a1
color6  #005582
color7  #515253
color8  #47494a
color9  #a70022
color10 #005d4f
color11 #972c00
color12 #3334c3
color13 #7d0091
color14 #00596f
color15 #959697
color232 #080808
color233 #111111
color234 #181818
color235 #1d1d1d
color236 #232323
color237 #2a2a2a
color238 #303030
color239 #363636
color240 #3d3d3d
color241 #434343
color242 #4a4a4a
color243 #515151
