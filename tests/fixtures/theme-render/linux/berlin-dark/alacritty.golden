[window]
padding = { x = 16, y = 12 }
# Preserve the generated sRGB palette and its tested contrast ratios.
opacity = 1.0
option_as_alt = "None"

[font]
size = 20
normal = { family = "JetBrainsMono Nerd Font" }
offset = { x = 0, y = 0 }

[colors.primary]
background = "#1c1b25"
foreground = "#f5f5f8"

[colors.cursor]
cursor = "#a7aaff"
text = "#1c1b25"

[colors.selection]
background = "#3b3a52"
text = "#f5f5f8"

[colors.normal]
black = "#3e3d49"
red = "#ff8081"
green = "#30d158"
yellow = "#ffd600"
blue = "#5cb8ff"
magenta = "#ea8dff"
cyan = "#3cd3fe"
white = "#b9b8ba"

[colors.bright]
black = "#a6a5b2"
red = "#ff8ac4"
green = "#00dac3"
yellow = "#ff9230"
blue = "#a7aaff"
magenta = "#fa9cff"
cyan = "#00d2e0"
white = "#e2e2e3"
