font_family JetBrainsMono Nerd Font
symbol_map U+E000-U+F8FF Symbols Nerd Font
font_size 20
# Taller rows, bars included, for the airier reference layout. Override with
# terminal_cell_height in chezmoi data (e.g. "100%" to restore the default).
modify_font cell_height 130%

window_padding_width 16
# A terminal is a large reading surface: keep it opaque so generated sRGB
# colours retain their tested contrast instead of blending with the wallpaper.
background_opacity 1.0
# Faint (SGR 2) text is still text: kitty draws it at dim_opacity, and 0.75
# turned a 7:1 colour into roughly 4.5:1. 1.0 keeps faint text at AAA.
dim_opacity 1.0
confirm_os_window_close 0
enable_audio_bell no
cursor_trail 0

background #1c1b25
foreground #f5f5f8
selection_background #3b3a52
selection_foreground #f5f5f8
cursor #a7aaff

color0  #3e3d49
color1  #ff8081
color2  #30d158
color3  #ffd600
color4  #5cb8ff
color5  #ea8dff
color6  #3cd3fe
color7  #b9b8ba
color8  #a6a5b2
color9  #ff8ac4
color10 #00dac3
color11 #ff9230
color12 #a7aaff
color13 #fa9cff
color14 #00d2e0
color15 #e2e2e3
color244 #a7a7a7
color245 #adadad
color246 #b4b4b4
color247 #bababa
color248 #c0c0c0
color249 #c7c7c7
color250 #cdcdcd
color251 #d4d4d4
color252 #dadada
color253 #e1e1e1
color254 #e7e7e7
color255 #eeeeee
