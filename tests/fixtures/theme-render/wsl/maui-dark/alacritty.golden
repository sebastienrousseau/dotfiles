[window]
padding = { x = 16, y = 12 }
# Preserve the generated sRGB palette and its tested contrast ratios.
opacity = 1.0
option_as_alt = "None"

[font]
size = 20
normal = { family = "JetBrainsMono Nerd Font" }
offset = { x = 0, y = 0 }

[colors.primary]
background = "#0f1f21"
foreground = "#f1f6f7"

[colors.cursor]
cursor = "#00d2e0"
text = "#0f1f21"

[colors.selection]
background = "#1c4248"
text = "#f1f6f7"

[colors.normal]
black = "#314143"
red = "#ff8282"
green = "#30d158"
yellow = "#ffd600"
blue = "#5cb8ff"
magenta = "#ea8dff"
cyan = "#3cd3fe"
white = "#b7b9b9"

[colors.bright]
black = "#97abae"
red = "#ff8ac4"
green = "#00dac3"
yellow = "#ff9230"
blue = "#a7aaff"
magenta = "#fa9cff"
cyan = "#00d2e0"
white = "#e2e3e3"
