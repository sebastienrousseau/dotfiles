#!/usr/bin/env bash
# mise-plugin-dot: install a version into $ASDF_INSTALL_PATH.
#
# Two install modes:
#   * Tagged release  (mise install dot@v0.2.539)
#       Downloads the dot-<version>.tar.gz release asset, verifies it
#       against dot-<version>.SHA256SUMS (fails closed), then runs the
#       archive's own `make install PREFIX=<install path>`.
#   * owner/repo spec (mise install dot@alice/cfg)
#       Runs `dot config init alice/cfg --no-apply` into a private source
#       and chezmoi config dir, then `make install PREFIX=<install path>`
#       from that clone. Nothing is applied and the user's chezmoi source
#       and config are left alone.

set -euo pipefail

VERSION="${ASDF_INSTALL_VERSION:-${MISE_INSTALL_VERSION:?missing install version}}"
DEST="${ASDF_INSTALL_PATH:-${MISE_INSTALL_PATH:?missing install path}}"
REPO_DEFAULT="${MISE_DOT_REPO:-sebastienrousseau/dotfiles}"
SUPPORTED="use a supported installer instead (install.sh, Homebrew, Scoop, AUR): https://github.com/${REPO_DEFAULT}/blob/main/docs/guides/INSTALL.md"

die() {
  printf 'install: %s\n' "$*" >&2
  exit 1
}

command -v make >/dev/null 2>&1 || die "make is required; $SUPPORTED"

tmp="$(mktemp -d -t mise-dot.XXXXXX)"
trap 'rm -rf "$tmp"' EXIT

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    die "sha256sum or shasum is required to verify the release"
  fi
}

install_from_repo() {
  if ! command -v dot >/dev/null 2>&1; then
    echo "install: 'dot' must be on PATH first to bootstrap by owner/repo" >&2
    echo "  install the maintainer's release with: mise install dot@latest" >&2
    exit 127
  fi
  local src="$tmp/source"
  CHEZMOI_SOURCE_DIR="$src" XDG_CONFIG_HOME="$tmp/config" \
    dot config init "$VERSION" --no-apply
  [[ -f "$src/GNUmakefile" && -f "$src/tools/release/stage-dot.sh" ]] ||
    die "$VERSION does not carry the dot CLI (no GNUmakefile with an install target); $SUPPORTED"
  make -C "$src" install PREFIX="$DEST"
}

install_release() {
  local ver="${VERSION#v}"
  local base="https://github.com/${REPO_DEFAULT}/releases/download/v${ver}"
  local archive="dot-${ver}.tar.gz" sums="dot-${ver}.SHA256SUMS" expected
  curl -fsSL -o "$tmp/$archive" "$base/$archive" ||
    die "no $archive asset on release v${ver} (this plugin installs 0.2.520 and later); $SUPPORTED"
  curl -fsSL -o "$tmp/$sums" "$base/$sums" ||
    die "no $sums asset on release v${ver}, refusing an unverified archive (this plugin installs 0.2.520 and later); $SUPPORTED"
  expected="$(awk -v f="$archive" '$2==f || $2=="*"f {print $1}' "$tmp/$sums" | head -1)"
  [[ -n "$expected" ]] || die "$sums has no entry for $archive"
  [[ "$expected" == "$(sha256_of "$tmp/$archive")" ]] || die "SHA256 mismatch for $archive"
  tar -xzf "$tmp/$archive" -C "$tmp"
  make -C "$tmp/dot-${ver}" install PREFIX="$DEST"
}

if [[ "$VERSION" == */* ]]; then
  install_from_repo
else
  install_release
fi

echo "Installed dot ${VERSION} to ${DEST}"
