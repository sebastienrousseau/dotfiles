#!/usr/bin/env bash

# run_onchange_26-rust-tools.sh.tmpl
# Rust toolchain and tools provisioning
{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") }}

set -euo pipefail

log_info() { printf '\n[INFO] %s\n' "$*"; }
log_warn() { printf '\n[WARN] %s\n' "$*"; }
log_error() { printf '\n[ERROR] %s\n' "$*" >&2; }

# Skip in containers unless explicitly enabled
if [[ "${DOTFILES_CONTAINER:-0}" = "1" && "${DOTFILES_RUST_IN_CONTAINER:-0}" != "1" ]]; then
  log_info "Skipping Rust tools in container environment"
  exit 0
fi

# rustup is the standalone install in $CARGO_HOME/bin on every OS, never
# Homebrew's or mise's: mise exports RUSTUP_TOOLCHAIN, which overrides
# rust-toolchain.toml, and with Homebrew's rustup beside the standalone one
# each one's proxies fall back to the other's, so a missing component such
# as rust-analyzer recursed forever.
CARGO_BIN="${CARGO_HOME:-$HOME/.cargo}/bin"

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

# rustup_target: the rustup-init platform for this OS and CPU, or nothing.
rustup_target() {
  case "$(uname -s)-$(uname -m)" in
    Linux-x86_64) echo x86_64-unknown-linux-gnu ;;
    Linux-aarch64 | Linux-arm64) echo aarch64-unknown-linux-gnu ;;
    Darwin-arm64) echo aarch64-apple-darwin ;;
    Darwin-x86_64) echo x86_64-apple-darwin ;;
  esac
}

# fetch_rustup_init <dir>: downloads this platform's rustup-init into <dir>
# and checks it against the checksum rust-lang.org publishes beside it. (It
# publishes none for the rustup-init.sh script: that URL is a 404.)
fetch_rustup_init() {
  local dir="$1" target base expected actual
  target="$(rustup_target)"
  if [[ -z "$target" ]]; then
    log_error "No rustup-init for $(uname -s) $(uname -m)."
    return 1
  fi
  base="https://static.rust-lang.org/rustup/dist/$target/rustup-init"
  if ! curl --proto '=https' --tlsv1.2 -fsSL -o "$dir/rustup-init" "$base" ||
    ! curl --proto '=https' --tlsv1.2 -fsSL -o "$dir/rustup-init.sha256" "$base.sha256"; then
    log_error "Failed to download the rustup installer or its checksum."
    return 1
  fi
  expected="$(awk '{print $1}' "$dir/rustup-init.sha256")"
  actual="$(sha256_of "$dir/rustup-init")"
  if [[ ! "$expected" =~ ^[0-9a-f]{64}$ || "$expected" != "$actual" ]]; then
    log_error "rustup installer checksum mismatch (expected=$expected actual=$actual)."
    return 1
  fi
  chmod +x "$dir/rustup-init"
}

brew_has_rustup() {
  command -v brew >/dev/null 2>&1 && brew list --formula rustup >/dev/null 2>&1
}

# ensure_rustup: installs the standalone rustup when it is missing and retires
# Homebrew's. Homebrew's goes only after the replacement is verified, so a
# failed download leaves the machine as it was. Toolchains in ~/.rustup stay.
ensure_rustup() {
  local tmp rc=0
  if [[ -x "$CARGO_BIN/rustup" ]]; then
    if brew_has_rustup; then
      log_info "Removing Homebrew's rustup; the standalone one in $CARGO_BIN stays."
      brew uninstall rustup || log_warn "Could not remove Homebrew's rustup: run 'brew uninstall rustup'."
    fi
    return 0
  fi
  if ! brew_has_rustup && command -v rustup >/dev/null 2>&1; then
    return 0
  fi
  log_info "Installing rustup..."
  tmp="$(umask 077 && mktemp -d)"
  if fetch_rustup_init "$tmp"; then
    if brew_has_rustup; then
      brew uninstall rustup || log_warn "Could not remove Homebrew's rustup."
    fi
    "$tmp/rustup-init" -y --no-modify-path --default-toolchain stable || rc=$?
  else
    rc=1
  fi
  rm -rf "$tmp"
  return "$rc"
}

if ! ensure_rustup; then
  log_warn "rustup is not installed; skipping Rust tools. Rerun 'chezmoi apply' to retry."
  exit 0
fi
export PATH="$CARGO_BIN:$PATH"
if ! command -v rustup >/dev/null 2>&1; then
  log_warn "rustup not found after install; skipping Rust tools."
  exit 0
fi

log_info "Rust tools: starting setup..."

# Update rustup and toolchain
log_info "Updating rustup and stable toolchain..."
rustup update stable --no-self-update 2>/dev/null || rustup update stable

# Install essential components
log_info "Installing Rust components..."
COMPONENTS=(
  "clippy"        # Linter
  "rustfmt"       # Formatter
  "rust-src"      # Source code for rust-analyzer
  "rust-analyzer" # LSP server
)

for component in "${COMPONENTS[@]}"; do
  if ! rustup component list --installed | grep -q "^${component}"; then
    log_info "Installing component: ${component}"
    rustup component add "$component" || log_warn "Failed to install ${component}"
  fi
done

# install_cargo_tool <binary> <crate> <version>: cargo install of the exact
# version pinned in [rust_tools] in .chezmoidata.toml, always with the
# crate's own Cargo.lock (--locked). No unlocked retry: a crate that only
# builds unlocked pulls dependency versions nobody reviewed.
install_cargo_tool() {
  local tool="$1"
  local package="$2"
  local version="${3:-}"

  if command -v "$tool" >/dev/null 2>&1; then
    log_info "${tool} already installed"
    return 0
  fi
  if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    log_warn "Skipping ${tool}: no pinned version for ${package}"
    return 0
  fi

  log_info "Installing ${tool} ${version}..."
  cargo install --locked --version "$version" "$package" || log_warn "Failed to install ${tool}"
}

# The cargo tools the dotfiles themselves use: stylua (the Lua formatter the
# Neovim config and the lint use) and cargo-update (`dot update --globals`
# upgrades Cargo packages with it; `dot doctor` checks it).
log_info "Installing cargo tools..."
install_cargo_tool "stylua" "stylua" {{ index .rust_tools "stylua" | quote }}
install_cargo_tool "cargo-install-update" "cargo-update" {{ index .rust_tools "cargo-update" | quote }}

# Rust development tools, compiled from source (about 16 minutes on a CI
# runner, most of a fresh install), so opt-in: features.rust_dev_tools in
# the per-host chezmoi config. Turning it on changes this script, so the
# next apply runs it.
{{- if .features.rust_dev_tools }}
install_cargo_tool "cargo-add" "cargo-edit" {{ index .rust_tools "cargo-edit" | quote }}
install_cargo_tool "cargo-watch" "cargo-watch" {{ index .rust_tools "cargo-watch" | quote }}
install_cargo_tool "cargo-audit" "cargo-audit" {{ index .rust_tools "cargo-audit" | quote }}
install_cargo_tool "cargo-outdated" "cargo-outdated" {{ index .rust_tools "cargo-outdated" | quote }}
install_cargo_tool "cargo-expand" "cargo-expand" {{ index .rust_tools "cargo-expand" | quote }}
install_cargo_tool "cargo-nextest" "cargo-nextest" {{ index .rust_tools "cargo-nextest" | quote }}
install_cargo_tool "cargo-deny" "cargo-deny" {{ index .rust_tools "cargo-deny" | quote }}
{{- else }}
log_info "Rust development tools (cargo-edit, -watch, -audit, -outdated, -expand, -nextest, -deny): off; set features.rust_dev_tools = true to build them"
{{- end }}

# Optional: sccache for distributed caching (large download)
if [[ "${DOTFILES_RUST_SCCACHE:-0}" = "1" ]]; then
  install_cargo_tool "sccache" "sccache" {{ index .rust_tools "sccache" | quote }}
fi

# Optional: cross-compilation tools
if [[ "${DOTFILES_RUST_CROSS:-0}" = "1" ]]; then
  install_cargo_tool "cross" "cross" {{ index .rust_tools "cross" | quote }}
  install_cargo_tool "cargo-zigbuild" "cargo-zigbuild" {{ index .rust_tools "cargo-zigbuild" | quote }}
fi

log_info "Rust tools setup complete!"

{{- end }}
