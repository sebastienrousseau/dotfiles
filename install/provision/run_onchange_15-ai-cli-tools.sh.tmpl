#!/usr/bin/env bash

# run_onchange_15-ai-cli-tools.sh.tmpl
{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}

# Strict error handling
set -euo pipefail

log_info() { printf '\n[INFO] %s\n' "$*"; }
log_error() { printf '\n[ERROR] %s\n' "$*" >&2; }

# The AI tools come from the roster (plugins/ai/roster.toml) through
# `dot ai install`: which tools, how each installs (mise or its native
# installer, verified by checksum) and at which pinned version. This script
# names no tool of its own. --yes also installs mise when it is missing.
DOT_BIN="${DOTFILES_SOURCE_DIR:?install.sh must export DOTFILES_SOURCE_DIR}/bin/dot"
log_info "Installing the AI tools (dot ai install)..."
DOTFILES_NONINTERACTIVE=1 bash "$DOT_BIN" ai install --yes ||
  log_error "Some AI tools were not installed (continuing...). Retry with: dot ai install"

# Install development tools globally (always via npm)
log_info "Installing development tools via npm..."

DEV_TOOLS=(
  "eslint_d"
  "prettier_d"
  "typescript"
  "typescript-language-server"
)

# Ensure Node.js is available for dev tools
if command -v node >/dev/null 2>&1; then
  for tool in "${DEV_TOOLS[@]}"; do
    log_info "Installing $tool..."
    npm install -g "$tool" 2>&1 || log_error "Failed to install $tool (continuing...)"
  done
else
  log_info "Node.js not found — skipping dev tools"
fi

log_info "AI tools and dev tools installation complete!"
log_info "List the AI tools with 'dot ai list'; 'dot update' keeps them updated."

{{- end -}}
