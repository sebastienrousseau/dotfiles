#!/usr/bin/env bash

# run_onchange_25-python-tools.sh.tmpl
{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}

set -euo pipefail

log_info() { printf '\n[INFO] %s\n' "$*"; }
log_error() { printf '\n[ERROR] %s\n' "$*" >&2; }

install_python_tool() {
  local tool="$1"

  if command -v uv >/dev/null 2>&1; then
    log_info "Installing ${tool} via uv..."
    uv tool install --upgrade "$tool" || log_error "Failed to install ${tool} via uv."
    return 0
  fi

  if command -v pipx >/dev/null 2>&1; then
    log_info "Installing ${tool} via pipx..."
    pipx install --force "$tool" || log_error "Failed to install ${tool} via pipx."
    return 0
  fi

  if command -v python3 >/dev/null 2>&1; then
    log_info "Installing ${tool} via pip..."
    python3 -m pip install --user -U "$tool" || log_error "Failed to install ${tool} via pip."
    return 0
  fi

  log_error "No python installer found for ${tool}. Install manually."
}

# install_python_plugin <host> <plugin>: a package with no command of its own
# (a pytest plugin), which `uv tool install` and `pipx install` refuse, goes
# into its host tool's environment instead.
install_python_plugin() {
  local host="$1" plugin="$2"

  if command -v uv >/dev/null 2>&1; then
    log_info "Installing ${plugin} into ${host} via uv..."
    uv tool install --upgrade "$host" --with "$plugin" || log_error "Failed to install ${plugin} via uv."
    return 0
  fi

  if command -v pipx >/dev/null 2>&1; then
    log_info "Installing ${plugin} into ${host} via pipx..."
    pipx inject "$host" "$plugin" || log_error "Failed to install ${plugin} via pipx."
    return 0
  fi

  install_python_tool "$plugin"
}

log_info "Python tools: starting setup..."

# Linting & formatting
install_python_tool "ruff"
install_python_tool "black"

# Type checking
install_python_tool "basedpyright"
install_python_tool "mypy"

# Testing
install_python_tool "pytest"
install_python_plugin "pytest" "pytest-cov"

# Security & auditing
install_python_tool "bandit"
install_python_tool "pip-audit"

# Development
install_python_tool "debugpy"
install_python_tool "ipython"
install_python_tool "poetry"

# Infrastructure
install_python_tool "ansible-lint"
install_python_tool "checkov"
install_python_tool "molecule"

# AI coding assistants
install_python_tool "aider-chat"
install_python_tool "posting"

{{- end -}}
