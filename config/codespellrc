# codespell configuration — `codespell --config config/codespellrc`
# Scope: prose and source. Generated, vendored, and lock files are skipped.
[codespell]
skip = .git,node_modules,*.lock,*.sum,mise.lock,requirements-docs.txt,.secrets.baseline,CHANGELOG.md,docs/archive,docs/.vitepress,site,_build,build,dist,coverage,*.png,*.jpg,*.svg,*.gif,*.heic,*.woff,*.woff2,*.ttf,*.otf,LICENSES
# Words codespell flags that are correct here. Each is a real term:
#   als/ALS  alias-listing helper       oll     Ollama alias prefix
#   ans      Ansible/answers fixtures   nd      Neovim leader-key binding
#   fpr/FPR  GPG fingerprint field      Hashi   HashiCorp
#   noice    noice.nvim plugin          intoto  in-toto attestation format
#   trough   GTK scrollbar widget part  crasher/crashers  fuzzing term for a
#                                              crash-triggering input
#   wth      appears inside config/typos.toml's own rules
ignore-words-list = als,ans,crasher,crashers,fpr,hashi,intoto,nd,noice,oll,trough,wth
quiet-level = 2
