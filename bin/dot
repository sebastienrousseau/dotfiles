#!/usr/bin/env bash
# shellcheck disable=SC2034
# SPDX-License-Identifier: Apache-2.0 OR MIT
# Copyright (c) 2015-2026 Sebastien Rousseau
set -euo pipefail

# Dotfiles CLI Entry Point - v0.2.536

# Ensure XDG Base Directory variables are set
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# Ensure PIPX paths are set
export PIPX_HOME="${XDG_DATA_HOME}/pipx"
export PIPX_BIN_DIR="${HOME}/.local/bin"

# Ensure Nix is in PATH if installed
if [ -e "${HOME}/.nix-profile/etc/profile.d/nix.sh" ]; then
  # shellcheck disable=SC1091
  . "${HOME}/.nix-profile/etc/profile.d/nix.sh"
fi

VERSION="0.2.536"

COMMAND="${1:-}"
if [ -n "${1:-}" ]; then
  shift
fi

# Resolve source directory (needed early for ui.sh sourcing)
_resolve_source_dir() {
  local dir=""
  local script_path=""
  local script_dir=""
  local repo_candidate=""

  # Follow symlinks first: `make install` links $(PREFIX)/bin/dot at
  # $(LIBEXECDIR)/bin/dot, and Homebrew links Cellar/…/bin/dot into
  # its prefix. Without this the dispatcher would resolve relative to
  # the link and fall through to ~/.dotfiles (which a packaged install
  # may not have). Pure-bash loop: `readlink -f` is not on older macOS.
  script_path="${BASH_SOURCE[0]}"
  while [ -L "$script_path" ]; do
    script_dir="$(dirname "$script_path")"
    script_path="$(readlink "$script_path")"
    case "$script_path" in
      /*) ;;
      *) script_path="$script_dir/$script_path" ;;
    esac
  done
  if script_path="$(cd "$(dirname "$script_path")" && pwd 2>/dev/null)"; then
    script_dir="$script_path"
    # Post-v0.2.536: the canonical dispatcher lives at <repo>/bin/dot, so
    # $script_dir/.. is the repo root. Pre-v0.2.536 (and chezmoi-deployed
    # wrapper invocations that still exec the canonical) the dispatcher
    # was at <repo>/dot_local/bin/executable_dot, so $script_dir/../..
    # was the repo. Probe both to cover the transition.
    for candidate in "$script_dir/.." "$script_dir/../.."; do
      if repo_candidate="$(cd "$candidate" && pwd 2>/dev/null)"; then
        :
      else
        repo_candidate=""
      fi
      if [ -n "$repo_candidate" ] && [ -f "$repo_candidate/lib/dot/ui.sh" ]; then
        dir="$repo_candidate"
        break
      fi
    done
  fi

  if [ -z "$dir" ] && [ -n "${CHEZMOI_SOURCE_DIR:-}" ] && [ -d "$CHEZMOI_SOURCE_DIR" ]; then
    dir="$CHEZMOI_SOURCE_DIR"
  elif [ -z "$dir" ] && [ -d "$HOME/.dotfiles" ]; then
    dir="$HOME/.dotfiles"
  elif [ -z "$dir" ] && [ -d "$HOME/.local/share/chezmoi" ]; then
    dir="$HOME/.local/share/chezmoi"
  elif [ -z "$dir" ] && [ -f "package.json" ] && grep -q '"name": "dotfiles"' package.json 2>/dev/null; then
    dir="$(pwd)"
  fi
  echo "$dir"
}

# Source shared UI library for consistent colors, checkmarks, and formatting.
# Falls back to minimal inline definitions if the source directory is unavailable.
_DOT_SRC="$(_resolve_source_dir)"
if [ -n "$_DOT_SRC" ] && [ -f "$_DOT_SRC/lib/dot/ui.sh" ]; then
  # shellcheck source=../../lib/dot/ui.sh
  # shellcheck disable=SC1091
  source "$_DOT_SRC/lib/dot/ui.sh"
  ui_init
  # ADR-020 names (N0.3): new spellings, deprecated, removed and shortcut
  # names, and the GNU -V/-v flags, resolved into today's routes.
  # shellcheck source-path=SCRIPTDIR source=../lib/dot/names.sh
  source "$_DOT_SRC/lib/dot/names.sh"
else
  _dot_names() {
    [[ -n "$1" ]] || show_help
    [[ -n "$1" ]] || exit 0
    _ARGV=("$@")
  }
  _dot_unknown() {
    echo "Unknown command: ${1:-}" >&2
    exit 127
  }
  # Minimal fallback when source dir is not available (e.g. first install)
  # shellcheck disable=SC2034
  UI_COLOR=0
  BOLD=""
  NORMAL=""
  RED=""
  GREEN=""
  YELLOW=""
  BLUE=""
  CYAN=""
  GRAY=""
  MAGENTA=""
  ui_init() {
    if [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]]; then
      UI_COLOR=1
      BASH_BOLD=$'\033[1m'
      NORMAL=$'\033[0m'
      RED=$'\033[38;5;196m'
      GREEN=$'\033[38;5;42m'
      YELLOW=$'\033[38;5;214m'
      BLUE=$'\033[38;5;63m'
      CYAN=$'\033[38;5;81m'
      GRAY=$'\033[38;5;244m'
      MAGENTA=$'\033[38;5;211m'
    fi
  }
  ui_header() {
    ui_init
    printf "\n  %s%s%s\n\n" "${BOLD}${BLUE}" "$1" "$NORMAL"
  }
  ui_section() {
    ui_init
    printf "  %s%s%s\n" "${BOLD}${CYAN}" "$1" "$NORMAL"
  }
  ui_cmd() {
    ui_init
    printf "  %s•%s %s%-16s%s %s\n" "$GREEN" "$NORMAL" "$GREEN" "$1" "$NORMAL" "$2"
  }
  ui_ok() {
    ui_init
    printf "  %s✓%s %-35s %s\n" "$GREEN" "$NORMAL" "$1" "${2:-}"
  }
  ui_info() {
    ui_init
    printf "  %s•%s %-35s %s\n" "$GRAY" "$NORMAL" "$1" "${2:-}"
  }
  ui_meta() {
    ui_init
    printf "  %s•%s %-14s %s\n" "$GRAY" "$NORMAL" "$1" "${2:-}"
  }
  ui_kv() {
    ui_init
    printf "  %s%-14s%s %s\n" "$BOLD" "$1" "$NORMAL" "$2"
  }
  ui_warn() {
    ui_init
    printf "  %s⚠%s %-35s %s\n" "$YELLOW" "$NORMAL" "$1" "${2:-}"
  }
  ui_err() {
    ui_init
    printf "  %s✗%s %-35s %s\n" "$RED" "$NORMAL" "$1" "${2:-}" >&2
  }
  ui_clear_line() { printf '\r\033[K'; }
  ui_toast() { case "$1" in success | ok) ui_ok "$2" ;; error | err) ui_err "$2" ;; warn) ui_warn "$2" ;; *) ui_info "$2" ;; esac }
fi

# Alias ui_fail → ui_err for backward compatibility in this script
ui_fail() { ui_err "$@"; }

ui_dot_banner() {
  local section="${1:-Dot}"
  if declare -F ui_product_banner >/dev/null 2>&1; then
    ui_product_banner "Dot • $section"
    return 0
  fi
  if declare -F ui_logo_dot >/dev/null 2>&1; then
    ui_logo_dot "Dot • $section"
  fi
}

show_version() {
  ui_dot_banner "Reference"
  ui_header "Dotfiles Version"
  echo ""
  ui_ok "Version" ".dotfiles $VERSION"
  if [[ -n "$_DOT_SRC" ]]; then
    ui_ok "Source" "$_DOT_SRC"
  fi
}

# The route and help tables are data, kept in lib/dot/data so the
# dispatcher, the doc generators, the QA gates and the tests read one
# source. _dot_data prints a table without forking, and stops at the first
# failed write: where SIGPIPE is ignored (CI, git hooks) a reader that exits
# early would otherwise get one "write error" per remaining line.
_dot_data() {
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    printf '%s\n' "$line" 2>/dev/null || return 0
  done <"${_DOT_SRC:-.}/lib/dot/data/$1"
}

_dot_help_specs() { _dot_data help-specs.txt; }

_dot_help_details() { _dot_data help-details.txt; }

_dot_help_summary() {
  local command_name="${1:-}"
  local summary
  summary="$(awk -F'|' -v command_name="$command_name" '$1 == command_name { print $2; exit }' < <(_dot_help_details))"
  if [[ -z "$summary" ]]; then
    summary="$(awk -F'|' -v command_name="$command_name" '$2 == command_name { print $3; exit }' < <(_dot_help_specs))"
  fi
  printf '%s\n' "$summary"
}

_dot_help_examples() {
  local command_name="${1:-}"
  awk -F'|' -v command_name="$command_name" '$1 == command_name { print $3; exit }' < <(_dot_help_details)
}

_dot_command_routes() { _dot_data routes.txt; }

_dot_command_route() {
  local command_name="${1:-}"
  if [[ -z "$command_name" ]]; then
    return 1
  fi
  # Pure-bash scan of the route table — avoids the extra awk fork on the hot
  # path of every invocation (routes stay in _dot_command_routes for the
  # tooling/tests that parse them from source).
  local cmd module
  while IFS='|' read -r cmd module; do
    if [[ "$cmd" == "$command_name" ]]; then
      printf '%s\n' "$module"
      return 0
    fi
  done < <(_dot_command_routes)
  return 1
}

# Help comes from lib/dot/help.sh; without it (first install) only the usage.
show_help_overview() {
  if declare -F _dot_help_overview >/dev/null; then
    _dot_help_overview
  else
    printf 'Usage: dot <domain> [object] <verb> [args]\n'
  fi
}

show_help_all() {
  if declare -F _dot_help_all >/dev/null; then
    _dot_help_all
  else
    show_help_overview
  fi
}

show_help_command() {
  local command_name="${1:-}"
  local normalized summary examples

  normalized="$command_name"
  if [[ "$command_name" == "version" || "$command_name" == "-V" ]]; then
    normalized="--version"
  fi

  summary="$(_dot_help_summary "$normalized")"
  examples="$(_dot_help_examples "$normalized")"

  if [[ -z "$summary" ]]; then
    # Not a command name: search for it (N8, `dot help <term>`).
    if _dot_help_search "$command_name"; then
      exit 0
    fi
    ui_fail "Unknown help topic: $command_name"
    ui_info "Hint" "Try 'dot help all'"
    exit 1
  fi

  ui_dot_banner "Reference"
  ui_header "dot $command_name"
  echo ""
  ui_info "Summary" "$summary"
  if [[ -n "$examples" ]]; then
    echo ""
    ui_section "Examples"
    while IFS= read -r example; do
      [[ -n "$example" ]] || continue
      ui_cmd "$example" ""
    done < <(printf '%b\n' "$examples")
  fi
}

show_help() {
  local topic="${1:-}"
  case "$topic" in
    "")
      show_help_overview
      ;;
    all)
      show_help_all
      ;;
    --json)
      cat "$_DOT_SRC/lib/dot/data/commands.json"
      ;;
    *)
      show_help_command "$topic"
      ;;
  esac
}

resolve_source_dir() { _resolve_source_dir; }

# ─── Dispatcher ───────────────────────────────────────────────────────────────
# Routes COMMAND to the appropriate command module in scripts/dot/commands/.
# Each module receives the original COMMAND as its first argument so that its
# internal case statement can dispatch to the right sub-function.
# Reuse the source dir already resolved at startup (line ~69) instead of
# re-running _resolve_source_dir (several cd/pwd subshells) on every invocation.
_SOURCE_DIR="$_DOT_SRC"
_CMD_DIR="${_SOURCE_DIR}/scripts/dot/commands"

_dispatch() {
  local module="$1"
  shift # remove module name; remaining $@ are the user's extra args
  local cmd_file="${_CMD_DIR}/${module}.sh"
  if [[ -f "$cmd_file" ]]; then
    # shellcheck disable=SC1090
    exec bash "$cmd_file" "$COMMAND" "$@"
  else
    ui_fail "${module}.sh not found ($cmd_file)"
    exit 1
  fi
}

_dot_names "$COMMAND" "$@"
set -- "${_ARGV[@]}"
COMMAND="$1"
shift

# _dispatch_args MODULE ARGS...: run a module that takes only the user's args.
_dispatch_args() {
  local cmd_file="${_CMD_DIR}/${1}.sh"
  shift
  if [[ -f "$cmd_file" ]]; then
    exec bash "$cmd_file" "$@"
  fi
  ui_fail "${cmd_file##*/} not found" >&2
  exit 1
}

# `|| true` is intentional: an unknown command yields an empty route, which falls
# through the case below into the user-command path that emits the proper error.
route="$(_dot_command_route "$COMMAND" || true)"

# ═════════════════════════════════════════════════════════════════
# Universal --help / -h intercept — MUST run before any dispatch.
# ═════════════════════════════════════════════════════════════════
# The 2026-07-05 command audit found ~22 commands that mishandled
# --help when passed as a sub-argument: `dot ai delegate --help`
# actually invoked the vibe delegate with prompt "--help" (spent
# money), `dot edit --help` opened the editor and blocked on TTY,
# `dot upgrade --help` ran the real upgrade including git pulls
# + nvim spawn, `dot sandbox --help` built a Docker sandbox, and
# many secrets/mode/agent subcommands treated --help as a data
# arg.
#
# The fix is at the dispatcher: if any user arg is --help or -h
# (before a `--` sentinel), delegate to `dot help <COMMAND>` before
# routing. This is the same route users get from `dot help <cmd>`
# and it honours the help renderer's terminal capabilities.
#
# Excluded from the intercept:
#   - `help` itself — `dot help --help` short-circuits to `dot help`.
#   - `search` — searching for the literal string "--help" is
#     surreal but we honour it if requested.
#   - top-level `--help`/`-h` (COMMAND=="--help") already handled
#     by the shebang-block long-option case.
_has_help_flag() {
  local a
  for a in "$@"; do
    case "$a" in
      --help | -h) return 0 ;;
      --) return 1 ;;
    esac
  done
  return 1
}

if [[ -n "$route" ]] && [[ "$route" != "help" ]] && [[ "$route" != "search" ]] &&
  _has_help_flag "$@"; then
  exec bash "$_SOURCE_DIR/bin/dot" help "$COMMAND"
fi

case "$route" in
  core | diagnostics | ai | tools | appearance | secrets | security | meta | fleet | completion | agents | init | registry)
    _dispatch "$route" "$@"
    ;;

  manual | patterns | system)
    _dispatch_args "$route" "$@"
    ;;

  search)
    keyword="${1:-}"
    if [[ -z "$keyword" ]]; then
      echo "Usage: dot search <keyword>"
      exit 1
    fi
    _dot_help_search "$keyword" || echo "No commands matching '$keyword'"
    exit 0
    ;;

  help)
    show_help "$@"
    ;;

  version)
    show_version
    ;;

  # User-provided custom commands, then bin/dot-<name> auto-shim
  # (git-style: `dot foo` -> `dot-foo` if a matching executable exists
  # anywhere on PATH). Users can drop new commands next to `dot` and
  # tab-completion will see them via the routes table extraction.
  *)
    _user_cmd="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/commands/${COMMAND}.sh"
    if [[ -f "$_user_cmd" ]]; then
      # Run in a subshell so a user `exit` doesn't kill the dot CLI.
      # This source path is intentionally user-defined.
      # shellcheck disable=SC1090
      (source "$_user_cmd" "$@")
      exit $?
    else
      # Try bin/dot-<name> in the same dir as this script, then $PATH.
      _self_dir="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
      if [[ -x "$_self_dir/dot-${COMMAND}" ]]; then
        exec "$_self_dir/dot-${COMMAND}" "$@"
      fi
      if command -v "dot-${COMMAND}" >/dev/null 2>&1; then
        exec "dot-${COMMAND}" "$@"
      fi
      _dot_unknown "$COMMAND" "$@"
    fi
    ;;
esac
