#!/usr/bin/env bash
# shellcheck disable=SC2034,SC1091
# 🅳🅾🆃🅵🅸🅻🅴🆂 - Deterministic Remote Provisioner
# Usage: curl -sL https://raw.githubusercontent.com/sebastienrousseau/dotfiles/main/dot_local/bin/executable_dot-bootstrap | bash
#
# This script provisions an entire machine from scratch using Nix.
# It installs the Nix package manager, clones the dotfiles,
# and drops you into a fully configured, isolated 2026 environment
# without modifying the host OS package system.

set -euo pipefail

# ANSI Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'

step() { printf '%b
' "${BLUE}==>${NC} ${BOLD}$1${NC}"; }
error() {
  printf '%b
' "${RED}==> Error: $1${NC}"
  exit 1
}

# The Nix installer runs as root (--daemon), so it is pinned to a release and
# its SHA-256. Keep in sync with security/remote-installers.sha256 (tested).
# The installer itself pins the per-platform tarball hashes it downloads.
NIX_INSTALLER_URL="https://releases.nixos.org/nix/nix-2.35.2/install"
NIX_INSTALLER_SHA256="9adda97297d9e8ab360df95c729eabff4f4f93d6db091953c3a68f29e3fb130c"

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    return 127
  fi
}

step "Starting Deterministic Bootstrap"

# 1. Install Nix (if not present)
if ! command -v nix >/dev/null 2>&1; then
  step "Installing Nix Package Manager..."
  nix_installer=$(umask 077 && mktemp)
  if ! curl --proto '=https' --tlsv1.2 -fsSL -o "$nix_installer" "$NIX_INSTALLER_URL"; then
    rm -f "$nix_installer"
    error "Failed to download Nix installer"
  fi
  if ! actual_sha="$(sha256_of "$nix_installer")"; then
    rm -f "$nix_installer"
    error "No SHA-256 tool (sha256sum or shasum) to verify the Nix installer"
  fi
  if [[ "$actual_sha" != "$NIX_INSTALLER_SHA256" ]]; then
    rm -f "$nix_installer"
    error "Nix installer checksum mismatch (expected $NIX_INSTALLER_SHA256, got $actual_sha)"
  fi
  sh "$nix_installer" --daemon
  rm -f "$nix_installer"
  # Source nix daemon script
  if [ -e '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh' ]; then
    . '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh'
  fi
else
  step "Nix is already installed."
fi

# 2. Enable Flakes
mkdir -p ~/.config/nix
if ! grep -q "experimental-features" ~/.config/nix/nix.conf 2>/dev/null; then
  echo "experimental-features = nix-command flakes" >>~/.config/nix/nix.conf
fi

# Release tags are SSH-signed. Only these keys may sign the release that gets
# applied (the same keys as defaults/dot_config/git/allowed_signers.tmpl).
release_signers() {
  cat <<'SIGNERS'
sebastienrousseau@users.noreply.github.com ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDjGRQyeM79nAb4GHcpGzXMKq7HE3xyEOev4gVsnBN1e
sebastienrousseau@users.noreply.github.com ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKY+QFE+TjJyo1txN/p+THGR2nWYmSjojdKmYWEvD4dh
sebastienrousseau@users.noreply.github.com ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAII32YuD6LxBOeFb5kG4Fqbm62kn9OkcHNPJtktO8iYVF
SIGNERS
}

# checkout_signed_release <dir>: check out the newest v* tag, refusing it
# unless its signature verifies against release_signers. The default branch
# is never applied: it carries commits no release has covered.
checkout_signed_release() {
  local dir="$1" tag signers rc=0
  git -C "$dir" fetch --quiet --tags origin || error "Could not fetch release tags"
  tag="$(git -C "$dir" tag --list 'v*' --sort=-v:refname | head -n 1)"
  [[ -n "$tag" ]] || error "No release tag found in $dir"
  signers="$(umask 077 && mktemp)"
  release_signers >"$signers"
  git -C "$dir" -c gpg.ssh.allowedSignersFile="$signers" verify-tag "$tag" >/dev/null 2>&1 || rc=$?
  rm -f "$signers"
  [[ "$rc" -eq 0 ]] || error "Release tag $tag is not signed by a pinned release key"
  git -C "$dir" -c advice.detachedHead=false checkout --quiet "$tag" ||
    error "Could not check out $tag"
  step "Using signed release $tag"
}

# 3. Clone Repository
DOTFILES_DIR="$HOME/.dotfiles"
if [ ! -d "$DOTFILES_DIR" ]; then
  step "Cloning Dotfiles..."
  git clone https://github.com/sebastienrousseau/dotfiles.git "$DOTFILES_DIR"
else
  step "Dotfiles repository already exists at $DOTFILES_DIR"
fi
checkout_signed_release "$DOTFILES_DIR"

# 4. Bootstrap Chezmoi via Nix & Apply. chezmoi comes from the nixpkgs commit
# locked in the release's flake.lock, not the moving registry entry.
step "Applying Configurations (Isolated)"
cd "$DOTFILES_DIR"
nix shell --inputs-from . nixpkgs#chezmoi -c chezmoi apply --force

# 5. Drop into the Environment
step "Bootstrapping Complete. Entering Deterministic Shell."
echo "You are now in an isolated shell containing Neovim, Fish, Nushell, and Pueue."
nix develop
